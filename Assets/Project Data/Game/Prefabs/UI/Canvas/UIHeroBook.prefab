  - heroId: 29
    heroName: "\u94F6\u9AEF\u667A\u8005 \xB7 \u6B27\u6797"
    heroDescription: "\u6B27\u6797\u662F\u5C71\u4E2D\u6BBF\u5802\u6700\u5E74\u957F\u7684\u52C7\u8005\u4E4B\u4E00\uFF0C\u4ED6\u90A3\u5982\u96EA\u7684\u94F6\u9AEF\u89C1\u8BC1\u4E86\u65E0\u6570\u4E2A\u4E16\u7EAA\u7684\u53D8\u8FC1\u3002\u4ED6\u66FE\u662F\u4E00\u4F4D\u4F1F\u5927\u7684\u6218\u58EB\uFF0C\u5982\u4ECA\u5E74\u4E8B\u5DF2\u9AD8\u7684\u4ED6\u5C06\u7CBE\u529B\u8F6C\u5411\u4E86\u5BF9\u53E4\u4EE3\u7B26\u6587\u548C\u6218\u672F\u7684\u7814\u7A76\u3002\u4ED6\u624B\u4E2D\u90A3\u628A\u5DE8\u5927\u7684\u53CC\u5203\u6218\u65A7\uFF0C\u4E0D\u4EC5\u950B\u5229\u65E0\u6BD4\uFF0C\u66F4\u8574\u542B\u7740\u80FD\u51BB\u7ED3\u65F6\u95F4\u7684\u5BD2\u51B0\u9B54\u529B\u3002\u6B27\u6797\u5728\u6218\u573A\u4E0A\u603B\u662F\u6CF0\u7136\u81EA\u82E5\uFF0C\u4ED6\u4E0D\u4EC5\u80FD\u7528\u51B0\u971C\u6CD5\u672F\u5EF6\u7F13\u654C\u4EBA\u7684\u653B\u52BF\uFF0C\u66F4\u80FD\u51ED\u85C9\u4E30\u5BCC\u7684\u7ECF\u9A8C\u8BC6\u7834\u654C\u4EBA\u7684\u7834\u7EFD\u3002\u4ED6\u662F\u961F\u4F0D\u4E2D\u7684\u5927\u8111\uFF0C\u662F\u6240\u6709\u5E74\u8F7B\u52C7\u8005\u7684\u5BFC\u5E08\u3002"
    heroSprite: {fileID: 21300000, guid: 028164c83a467b246887e1ee58e52eca, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 3960c223e45af2d48b396422785ffa91, type: 3}
    defaultUnlocked: 0
  - heroId: 30
    heroName: "\u79D8\u5965\u5BFC\u5E08 \xB7 \u51E1\u6797"
    heroDescription: "\u51E1\u6797\u662F\u5C71\u4E2D\u6BBF\u5802\u9B54\u6CD5\u5B66\u9662\u7684\u73B0\u4EFB\u9662\u957F\uFF0C\u4E00\u4F4D\u5728\u5965\u672F\u9886\u57DF\u8FBE\u5230\u9876\u5CF0\u7684\u667A\u8005\u3002\u4ED6\u624B\u4E2D\u7684\u201C\u79D8\u5965\u6CD5\u6756\u201D\u9876\u7AEF\u9576\u5D4C\u7740\u4E00\u9897\u636E\u4F20\u662F\u4ECE\u53E6\u4E00\u4E2A\u4F4D\u9762\u53EC\u5524\u800C\u6765\u7684\u5DE8\u5927\u7EA2\u5B9D\u77F3\uFF0C\u6CD5\u6756\u672C\u8EAB\u5219\u7531\u4E0A\u53E4\u9B54\u6811\u7684\u679D\u5E72\u5236\u6210\u3002\u51E1\u6797\u4E0D\u4EC5\u80FD\u65BD\u5C55\u6BC1\u5929\u706D\u5730\u7684\u653B\u51FB\u9B54\u6CD5\uFF0C\u66F4\u7CBE\u901A\u7A7A\u95F4\u7A7F\u68AD\u548C\u7CBE\u795E\u63A7\u5236\u3002\u4ED6\u90A3\u4EFF\u4F5B\u80FD\u770B\u7A7F\u4E00\u5207\u7684\u773C\u795E\uFF0C\u603B\u662F\u8BA9\u9B54\u7269\u4E0D\u5BD2\u800C\u6817\u3002\u5728\u6218\u573A\u4E0A\uFF0C\u4ED6\u4E0D\u4EC5\u662F\u5F3A\u5927\u7684\u706B\u529B\u8F93\u51FA\uFF0C\u66F4\u662F\u80FD\u591F\u64CD\u63A7\u5168\u5C40\u3001\u4E3A\u540C\u4F34\u521B\u9020\u7EDD\u4F73\u673A\u4F1A\u7684\u6218\u672F\u5927\u5E08\u3002"
    heroSprite: {fileID: 21300000, guid: e8a57592cc6eaf34782d4ff8191427e4, type: 3}
