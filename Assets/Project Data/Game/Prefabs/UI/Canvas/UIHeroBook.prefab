  - heroId: 13
    heroName: "\u83F2\u5965\u5A1C"
    heroDescription: "\u83F2\u5965\u5A1C\u751F\u6D3B\u5728\u738B\u56FD\u8FB9\u5883\u7684\u6797\u5730\u533A\u57DF\uFF0C\u957F\u671F\u8D1F\u8D23\u8BB0\u5F55\u68EE\u6797\u8DEF\u5F84\u3001\u690D\u7269\u5206\u5E03\u548C\u5B63\u8282\u53D8\u5316\u3002\u5979\u6709\u4E00\u5934\u67D4\u987A\u7684\u957F\u53D1\uFF0C\u8EAB\u7A7F\u5E26\u6709\u85E4\u8513\u7EB9\u6837\u7684\u6797\u5730\u957F\u888D\uFF0C\u6574\u4F53\u9020\u578B\u6E05\u65B0\u81EA\u7136\u3002\u83F2\u5965\u5A1C\u4F7F\u7528\u4E00\u628A\u8F7B\u4FBF\u957F\u5F13\uFF0C\u5F13\u8EAB\u88C5\u9970\u7740\u53F6\u7247\u4E0E\u7FBD\u6BDB\u7EB9\u6837\u3002\u5979\u89C6\u529B\u654F\u9510\uFF0C\u884C\u52A8\u8F7B\u5DE7\uFF0C\u80FD\u5728\u590D\u6742\u7684\u6811\u6797\u4E2D\u8FA8\u8BA4\u65B9\u5411\uFF0C\u4E5F\u80FD\u901A\u8FC7\u98CE\u5411\u3001\u811A\u5370\u548C\u679D\u53F6\u53D8\u5316\u5224\u65AD\u9644\u8FD1\u7684\u60C5\u51B5\u3002\u5BF9\u5979\u6765\u8BF4\uFF0C\u68EE\u6797\u4E0D\u662F\u964C\u751F\u7684\u8352\u91CE\uFF0C\u800C\u662F\u4E00\u5F20\u9700\u8981\u8010\u5FC3\u9605\u8BFB\u7684\u5730\u56FE\u3002"
    heroSprite: {fileID: 21300000, guid: fbd2c68c47519f446a1f2bd6899d1e8d, type: 3}
