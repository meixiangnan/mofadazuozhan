  - heroId: 23
    heroName: "\u5E0C\u5C14"
    heroDescription: "\u5E0C\u5C14\u662F\u6765\u81EA\u8FB9\u5883\u5730\u533A\u7684\u6E38\u4FA0\uFF0C\u7559\u7740\u7070\u8272\u77ED\u53D1\uFF0C\u884C\u52A8\u654F\u6377\uFF0C\u64C5\u957F\u4F7F\u7528\u957F\u5F13\u3002\u4ED6\u4ECE\u5C0F\u719F\u6089\u96EA\u5730\u3001\u5C71\u5761\u548C\u8FB9\u5883\u9053\u8DEF\uFF0C\u5BF9\u8DDD\u79BB\u3001\u98CE\u5411\u548C\u5730\u5F62\u53D8\u5316\u6709\u8F83\u5F3A\u7684\u5224\u65AD\u529B\u3002\u5E0C\u5C14\u624B\u4E2D\u7684\u957F\u5F13\u5E26\u6709\u51B0\u7FCE\u56FE\u6848\uFF0C\u5F13\u8EAB\u7EBF\u6761\u8F7B\u5DE7\uFF0C\u4FBF\u4E8E\u5728\u590D\u6742\u73AF\u5883\u4E2D\u643A\u5E26\u548C\u4F7F\u7528\u3002\u4ED6\u80FD\u591F\u5C06\u51B0\u5143\u7D20\u9644\u7740\u5728\u7BAD\u77E2\u4E0A\uFF0C\u7528\u6765\u6807\u8BB0\u8FDC\u5904\u76EE\u6807\u3001\u63D0\u793A\u65B9\u5411\u6216\u63D0\u9192\u540C\u884C\u8005\u6CE8\u610F\u9053\u8DEF\u53D8\u5316\u3002\u5E0C\u5C14\u6027\u683C\u5B89\u9759\uFF0C\u4E0D\u559C\u6B22\u591A\u8BF4\u8BDD\uFF0C\u4F46\u89C2\u5BDF\u7EC6\u81F4\uFF0C\u5E38\u80FD\u4ECE\u98CE\u96EA\u4E2D\u7684\u7EC6\u5C0F\u75D5\u8FF9\u5224\u65AD\u51FA\u524D\u65B9\u7684\u73AF\u5883\u60C5\u51B5\u3002"
    heroSprite: {fileID: 21300000, guid: 0167370af45a85045b88d7a09bedaf8a, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 13772cf663d4f654ab1d9ea9752fef6d, type: 3}
    defaultUnlocked: 0
  - heroId: 24
    heroName: "\u585E\u4E3D\u5A1C"
    heroDescription: "\u585E\u4E3D\u5A1C\u6765\u81EA\u8FB9\u5883\u8981\u585E\u9644\u8FD1\u7684\u5BB6\u5EAD\uFF0C\u81EA\u5E7C\u63A5\u89E6\u8981\u585E\u4E2D\u7684\u4E66\u7C4D\u548C\u6CD5\u672F\u8BB0\u5F55\u3002\u5979\u4ECE\u5C0F\u5BF9\u6CD5\u672F\u7B26\u53F7\u548C\u5143\u7D20\u53D8\u5316\u5F88\u611F\u5174\u8DA3\uFF0C\u540E\u6765\u5728\u8001\u5E08\u7684\u6307\u5BFC\u4E0B\uFF0C\u9010\u6B65\u5B66\u4E60\u4E86\u8F83\u4E3A\u7CFB\u7EDF\u7684\u6CD5\u672F\u77E5\u8BC6\u3002\u585E\u4E3D\u5A1C\u624B\u6301\u4E00\u67C4\u540D\u4E3A\u201C\u96EA\u83B2\u201D\u7684\u6CD5\u6756\uFF0C\u6756\u8EAB\u9020\u578B\u6E05\u96C5\uFF0C\u5E26\u6709\u51B0\u96EA\u4E0E\u82B1\u74E3\u7EB9\u6837\u3002\u5979\u64C5\u957F\u6574\u7406\u4E0D\u540C\u7C7B\u578B\u7684\u6CD5\u672F\u8D44\u6599\uFF0C\u4E5F\u80FD\u6839\u636E\u73AF\u5883\u53D8\u5316\u9009\u62E9\u5408\u9002\u7684\u9632\u62A4\u65B9\u5F0F\u3002\u8FB9\u585E\u7684\u6E56\u6C34\u3001\u96EA\u539F\u548C\u5BD2\u98CE\uFF0C\u957F\u671F\u5F71\u54CD\u7740\u5979\u5BF9\u6CD5\u672F\u7684\u7406\u89E3\uFF0C\u4F7F\u5979\u7684\u6CD5\u672F\u98CE\u683C\u663E\u5F97\u5B89\u9759\u3001\u7EC6\u817B\u800C\u7A33\u5B9A\u3002"
    heroSprite: {fileID: 21300000, guid: a65c5249d0a4a1444bc71595b566b1ca, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 953f7a3cf4a34b543acd79331120b7bd, type: 3}
    defaultUnlocked: 0
  - heroId: 25
    heroName: " \u683C\u7F57\u59C6"
    heroDescription: "\u683C\u7F57\u59C6\u6765\u81EA\u5C71\u5730\u5DE5\u574A\uFF0C\u65E2\u719F\u6089\u77FF\u77F3\u5F00\u91C7\uFF0C\u4E5F\u64C5\u957F\u5728\u5DE5\u5177\u548C\u88C5\u5907\u4E0A\u523B\u5199\u7B26\u6587\u3002\u4ED6\u8EAB\u6750\u9AD8\u5927\uFF0C\u6027\u683C\u6C89\u7A33\uFF0C\u5E73\u65F6\u8BDD\u4E0D\u591A\uFF0C\u4F46\u5BF9\u953B\u9020\u3001\u5CA9\u5C42\u548C\u77FF\u77F3\u7EB9\u7406\u5F88\u6709\u7814\u7A76\u3002\u683C\u7F57\u59C6\u5E38\u5E26\u7740\u4E00\u67C4\u9576\u5D4C\u7EFF\u8272\u5B9D\u77F3\u7684\u53CC\u5203\u65A7\uFF0C\u65A7\u8EAB\u523B\u6709\u4ED6\u4EB2\u624B\u6574\u7406\u7684\u7B26\u6587\u56FE\u6848\u3002\u90A3\u679A\u5B9D\u77F3\u6765\u81EA\u706B\u5C71\u533A\u57DF\u7684\u7A00\u6709\u77FF\u77F3\uFF0C\u7ECF\u8FC7\u6253\u78E8\u540E\u5448\u73B0\u51FA\u6E29\u6DA6\u7684\u5149\u6CFD\u3002\u957F\u671F\u5728\u5C71\u5730\u548C\u5DE5\u574A\u4E4B\u95F4\u5F80\u6765\uFF0C\u4F7F\u4ED6\u5BF9\u6E29\u5EA6\u3001\u77F3\u6750\u548C\u5730\u5F62\u53D8\u5316\u683C\u5916\u654F\u611F\u3002"
    heroSprite: {fileID: 21300000, guid: 58a333a546b0193408a3187d85b48f24, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 37248b98d188b6a438be981d8b7e03b2, type: 3}
    defaultUnlocked: 0
  - heroId: 26
    heroName: "\u5DF4\u6797"
    heroDescription: "\u5DF4\u6797\u662F\u5C71\u5730\u6BBF\u5802\u4E2D\u7684\u5B88\u62A4\u8005\uFF0C\u957F\u671F\u8D1F\u8D23\u6BBF\u5802\u9053\u8DEF\u3001\u5DE5\u574A\u548C\u4ED3\u5E93\u7684\u65E5\u5E38\u7EF4\u62A4\u3002\u4ED6\u6027\u683C\u7A33\u91CD\uFF0C\u505A\u4E8B\u8BA4\u771F\uFF0C\u4E60\u60EF\u628A\u6BCF\u4E00\u4EF6\u5DE5\u5177\u548C\u88C5\u5907\u90FD\u6574\u7406\u5F97\u4E95\u4E95\u6709\u6761\u3002\u5DF4\u6797\u4F69\u6234\u7531\u5C71\u4E2D\u7279\u6709\u91D1\u5C5E\u6253\u9020\u7684\u5934\u76D4\uFF0C\u80FD\u591F\u9002\u5E94\u9AD8\u6E29\u5DE5\u574A\u548C\u706B\u5C71\u9644\u8FD1\u7684\u73AF\u5883\u3002\u4ED6\u624B\u4E2D\u7684\u6218\u9524\u540D\u4E3A\u201C\u7834\u6653\u201D\uFF0C\u9524\u5934\u7531\u4E00\u5757\u5E26\u6709\u91D1\u8272\u5149\u6CFD\u7684\u661F\u77F3\u6253\u78E8\u800C\u6210\uFF0C\u5916\u5F62\u539A\u91CD\u800C\u7AEF\u6B63\u3002\u5DF4\u6797\u719F\u6089\u91D1\u5C5E\u3001\u706B\u5019\u548C\u953B\u9020\u6D41\u7A0B\uFF0C\u4E5F\u61C2\u5F97\u57FA\u7840\u9632\u62A4\u6CD5\u672F\u3002\u9047\u5230\u5668\u5177\u53D7\u635F\u3001\u9053\u8DEF\u677E\u52A8\u6216\u5DE5\u574A\u9700\u8981\u4FEE\u6574\u65F6\uFF0C\u4ED6\u603B\u80FD\u7528\u6C89\u7A33\u7684\u65B9\u5F0F\u628A\u4E8B\u60C5\u5904\u7406\u59A5\u5F53\u3002"
    heroSprite: {fileID: 21300000, guid: f521e18b84439e24a9b2ab56ff8cfc62, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 516559a19feccc6439e7daa2bdb08f35, type: 3}
    defaultUnlocked: 0
  - heroId: 27
    heroName: "\u827E\u745E\u514B"
    heroDescription: "\u827E\u745E\u514B\u662F\u5C71\u5730\u5DE5\u574A\u4E2D\u5C11\u89C1\u7684\u6676\u77F3\u6CD5\u672F\u7814\u7A76\u8005\u3002\u4ED6\u4E0D\u50CF\u591A\u6570\u5DE5\u5320\u90A3\u6837\u53EA\u4E13\u6CE8\u4E8E\u91D1\u5C5E\u953B\u9020\uFF0C\u800C\u662F\u957F\u671F\u7814\u7A76\u6DF1\u5C71\u6676\u77F3\u7684\u7EB9\u7406\u3001\u5149\u6CFD\u548C\u5143\u7D20\u53CD\u5E94\u3002\u827E\u745E\u514B\u624B\u6301\u4E00\u67C4\u540D\u4E3A\u201C\u6676\u8000\u201D\u7684\u6CD5\u6756\uFF0C\u6756\u8EAB\u7531\u6253\u78E8\u540E\u7684\u6676\u77F3\u5236\u6210\uFF0C\u9876\u7AEF\u9576\u5D4C\u7740\u660E\u4EAE\u7684\u5965\u672F\u6676\u77F3\uFF0C\u5E76\u914D\u6709\u7EC6\u5C0F\u7684\u7B26\u6587\u6302\u9970\u3002\u827E\u745E\u514B\u6027\u683C\u5B89\u9759\uFF0C\u505A\u4E8B\u7EC6\u81F4\uFF0C\u64C5\u957F\u8BB0\u5F55\u4E0D\u540C\u6676\u77F3\u5728\u6E29\u5EA6\u3001\u5149\u7EBF\u548C\u6CD5\u672F\u4F5C\u7528\u4E0B\u7684\u53D8\u5316\u3002\u5BF9\u4ED6\u6765\u8BF4\uFF0C\u6BCF\u4E00\u79CD\u6676\u4F53\u90FD\u6709\u81EA\u5DF1\u7684\u7ED3\u6784\u548C\u89C4\u5F8B\uFF0C\u53EA\u6709\u8010\u5FC3\u89C2\u5BDF\uFF0C\u624D\u80FD\u7406\u89E3\u5176\u4E2D\u7684\u7A33\u5B9A\u529B\u91CF\u3002"
    heroSprite: {fileID: 21300000, guid: a3dad200307ee0b4d955ea7d6656117f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 69ece6436e075b446b9dcbfdc16baac2, type: 3}
    defaultUnlocked: 0
  - heroId: 28
    heroName: "\u7D22\u5C14"
    heroDescription: "\u7D22\u5C14\u662F\u5C71\u5730\u6BBF\u5802\u4E2D\u7684\u706B\u5143\u7D20\u6CD5\u672F\u4F7F\u7528\u8005\uFF0C\u62E5\u6709\u4E00\u5934\u9192\u76EE\u7684\u7EA2\u53D1\u3002\u76F8\u6BD4\u539A\u91CD\u94E0\u7532\uFF0C\u4ED6\u66F4\u4E60\u60EF\u7A7F\u7740\u4FBF\u4E8E\u884C\u52A8\u7684\u8D64\u7EA2\u8272\u6CD5\u888D\uFF0C\u8863\u6599\u4E0A\u5E26\u6709\u7B80\u5355\u7684\u7B26\u6587\u7EB9\u6837\u3002\u7D22\u5C14\u624B\u4E2D\u7684\u6218\u9524\u5E76\u4E0D\u53EA\u662F\u5DE5\u5177\uFF0C\u4E5F\u5E38\u88AB\u4ED6\u7528\u6765\u8F85\u52A9\u65BD\u5C55\u706B\u5143\u7D20\u6CD5\u672F\u3002\u4ED6\u6027\u683C\u76F4\u63A5\uFF0C\u505A\u4E8B\u4E0D\u559C\u6B22\u62D6\u5EF6\uFF0C\u5BF9\u706B\u5019\u3001\u6E29\u5EA6\u548C\u77FF\u77F3\u53D8\u5316\u5341\u5206\u654F\u611F\u3002\u65E0\u8BBA\u662F\u5DE5\u574A\u7089\u706B\u7684\u8C03\u8282\uFF0C\u8FD8\u662F\u5BD2\u51B7\u5C71\u9053\u4E2D\u7684\u53D6\u6696\u7167\u660E\uFF0C\u4ED6\u603B\u80FD\u7528\u7B80\u5355\u6709\u6548\u7684\u65B9\u6CD5\u5904\u7406\u3002"
    heroSprite: {fileID: 21300000, guid: dd710d51cf613f14a94e657b78e45ec0, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: c02c5352bfc2afc42a4cffb8aadcf479, type: 3}
