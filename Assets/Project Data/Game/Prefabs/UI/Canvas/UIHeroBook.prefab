  m_Name: 
  m_EditorClassIdentifier: 
  returnBtn: {fileID: 4636885601793823118}
  heroGridView: {fileID: 7491997221282314378}
  itemPrefabName: HeroBookItem
  heroDatas:
  - heroId: 1
    heroName: "\u5723\u8000\u9A91\u58EB\u957F \xB7 \u4E9A\u745F"
    heroDescription: "\u4F5C\u4E3A\u7687\u5BB6\u9A91\u58EB\u56E2\u7684\u6B63\u7EDF\u7EE7\u627F\u4EBA\uFF0C\u4E9A\u745F\u4ECE\u5C0F\u63A5\u53D7\u6700\u4E25\u82DB\u7684\u5E1D\u738B\u5B66\u4E0E\u5251\u672F\u8BAD\u7EC3\u3002\u4ED6\u7559\u7740\u4E00\u5934\u8000\u773C\u7684\u91D1\u8272\u77ED\u53D1\uFF0C\u575A\u6BC5\u7684\u76EE\u5149\u4E2D\u900F\u7740\u4E0D\u5BB9\u7F6E\u7591\u7684\u5A01\u4E25\u3002\u4ED6\u6240\u4F69\u6234\u7684\u201C\u8A93\u7EA6\u80DC\u5229\u4E4B\u5251\u201D\u4E0E\u201C\u5723\u738B\u4E4B\u76FE\u201D\uFF0C\u662F\u7531\u5E1D\u56FD\u56FD\u5E93\u4E2D\u6700\u7EAF\u51C0\u7684\u5723\u91D1\u6253\u9020\uFF0C\u80FD\u591F\u5F15\u53D1\u5171\u9E23\u3002\u5728\u6218\u573A\u4E0A\uFF0C\u4E9A\u745F\u603B\u662F\u51B2\u950B\u5728\u6700\u524D\u7EBF\uFF0C\u5F53\u4ED6\u9AD8\u4E3E\u957F\u5251\uFF0C\u5723\u5149\u4E0D\u4EC5\u4F1A\u5316\u4F5C\u65A9\u88C2\u9ED1\u6697\u7684\u950B\u8292\uFF0C\u66F4\u80FD\u8D4B\u4E88\u5168\u519B\u65E0\u754F\u7684\u5D07\u9AD8\u6218\u610F\u3002"
    heroSprite: {fileID: 21300000, guid: 462050d1afdbd72448df26a675ae0117, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a566b9dafc4a3af40b5991e8617d9d29, type: 3}
    defaultUnlocked: 0
  - heroId: 2
    heroName: "\u82CD\u7A79\u4E4B\u67AA \xB7 \u5170\u65AF\u6D1B\u7279"
    heroDescription: "\u5170\u65AF\u6D1B\u7279\u662F\u7687\u5BB6\u4EB2\u536B\u961F\u4E2D\u6700\u5E74\u8F7B\u7684\u5929\u624D\u67AA\u672F\u5BB6\u3002\u4ED6\u8EAB\u62AB\u6D41\u7EBF\u578B\u7684\u767D\u91D1\u9F99\u7EB9\u94E0\u7532\uFF0C\u624B\u6301\u4E00\u67C4\u957F\u8FBE\u4E24\u7C73\u7684\u5E1D\u56FD\u81F3\u5B9D\u201C\u82CD\u7A79\u7834\u9635\u67AA\u201D\u3002\u4ED6\u7684\u67AA\u672F\u5982\u540C\u4ED6\u7684\u6027\u683C\u4E00\u822C\u9A84\u50B2\u4E14\u51CC\u5389\uFF0C\u80FD\u5728\u4E00\u77AC\u95F4\u523A\u51FA\u6570\u70B9\u5BD2\u661F\u3002\u4F5C\u4E3A\u5B98\u65B9\u91CD\u70B9\u57F9\u517B\u7684\u201C\u738B\u724C\u51B3\u6597\u8005\u201D\uFF0C\u5170\u65AF\u6D1B\u7279\u6700\u64C5\u957F\u7A81\u5165\u654C\u9635\uFF0C\u5BF9\u9B54\u7269\u9996\u9886\u8FDB\u884C\u7CBE\u51C6\u7684\u65A9\u9996\u884C\u52A8\u3002\u5BF9\u4ED6\u800C\u8A00\uFF0C\u80DC\u5229\u4E0D\u4EC5\u662F\u4EFB\u52A1\uFF0C\u66F4\u662F\u5BF9\u7687\u5BB6\u7FBD\u7FFC\u4E0D\u53EF\u73B7\u6C61\u7684\u5C0A\u4E25\u5BA3\u544A\u3002"
    heroSprite: {fileID: 21300000, guid: 426f038df489101488202c0fc661ab2c, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a094b58777415e643a947cd4dd0671db, type: 3}
    defaultUnlocked: 0
  - heroId: 3
    heroName: "\u7687\u5BB6\u795E\u5C04\u624B \xB7 \u7F57\u5BBE"
    heroDescription: "\u7F57\u5BBE\u662F\u5B98\u65B9\u7279\u6B8A\u60C5\u62A5\u90E8\u961F\u7684\u7EDF\u5E05\uFF0C\u4E5F\u662F\u6DF1\u5F97\u56FD\u738B\u4FE1\u4EFB\u7684\u201C\u5E1D\u56FD\u5185\u536B\u201D\u3002\u4ED6\u624B\u4E2D\u90A3\u628A\u6D41\u7EBF\u578B\u7684\u201C\u91D1\u7FBD\u8FFD\u9B42\u5F13\u201D\u5E94\u7528\u4E86\u5E1D\u56FD\u6700\u65B0\u7684\u70BC\u91D1\u9644\u9B54\u6280\u672F\uFF0C\u53EF\u4EE5\u81EA\u52A8\u9501\u5B9A\u654C\u4EBA\u7684\u7CBE\u795E\u6CE2\u52A8\u3002\u7F57\u5BBE\u7684\u7070\u8272\u77ED\u53D1\u4E0B\u662F\u4E00\u53CC\u770B\u900F\u4E00\u5207\u7684\u654F\u9510\u773C\u775B\uFF0C\u4ED6\u4E0D\u9700\u8981\u5728\u524D\u7EBF\u4E0E\u654C\u4EBA\u8089\u640F\uFF0C\u800C\u662F\u4F2B\u7ACB\u4E8E\u9AD8\u8038\u7684\u7687\u5BB6\u58C1\u5792\u4E4B\u4E0A\uFF0C\u7528\u9644\u5E26\u4E86\u7206\u88C2\u5723\u5149\u7684\u7BAD\u77E2\uFF0C\u5728\u5343\u7C73\u4E4B\u5916\u5C06\u654C\u65B9\u7684\u6307\u6325\u5B98\u9489\u6B7B\u5728\u738B\u56FD\u7684\u7586\u57DF\u4E4B\u5916\u3002"
    heroSprite: {fileID: 21300000, guid: df2d41bfb97a51c498cd60d4c170663b, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 5135f18f8d8f4f64bad2b51816c029d9, type: 3}
    defaultUnlocked: 0
  - heroId: 4
    heroName: "\u5723\u5F8B\u5927\u5BFC\u5E08 \xB7 \u5C24\u91CC\u5B89"
    heroDescription: "\u5C24\u91CC\u5B89\u662F\u7687\u5BB6\u9B54\u5BFC\u5E08\u56E2\u7684\u6700\u9AD8\u8D1F\u8D23\u4EBA\uFF0C\u4E5F\u662F\u5E1D\u56FD\u5F8B\u6CD5\u7684\u7EDD\u5BF9\u634D\u536B\u8005\u3002\u4ED6\u624B\u6301\u4EE3\u8868\u738B\u6743\u7684\u201C\u5723\u5F8B\u6743\u6756\u201D\uFF0C\u9876\u7AEF\u7684\u5DE8\u578B\u5965\u672F\u6C34\u6676\u8DF3\u52A8\u7740\u8C61\u5F81\u5BA1\u5224\u7684\u7D2B\u8272\u96F7\u9706\u4E0E\u5723\u5149\u3002\u5C24\u91CC\u5B89\u7CBE\u901A\u5927\u8303\u56F4\u7684\u6218\u7565\u7EA7\u9632\u5FA1\u7ED3\u754C\u4E0E\u5236\u88C1\u9B54\u6CD5\u3002\u5728\u6218\u573A\u4E0A\uFF0C\u4ED6\u662F\u51B7\u9177\u7684\u6267\u6CD5\u4EBA\uFF0C\u968F\u7740\u4ED6\u6325\u52A8\u6743\u6756\uFF0C\u5929\u7A7A\u4E2D\u5C06\u843D\u4E0B\u7531\u5E1D\u56FD\u56FD\u8FD0\u52A0\u6301\u7684\u5BA1\u5224\u5149\u7011\uFF0C\u5C06\u4EFB\u4F55\u6562\u4E8E\u4FB5\u72AF\u56FD\u571F\u7684\u9B54\u7269\u84B8\u53D1\u6B86\u5C3D\u3002"
    heroSprite: {fileID: 21300000, guid: 9030dfd0d4b7a6b43aeeea119d199ee1, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 63cd63a753682474f8934ddca5f10b99, type: 3}
    defaultUnlocked: 0
  - heroId: 5
    heroName: "\u7EAF\u767D\u8537\u8587 \xB7 \u4E3D\u5948\u7279"
    heroDescription: "\u4E3D\u5948\u7279\u662F\u5E1D\u56FD\u5927\u516C\u7684\u72EC\u751F\u5973\uFF0C\u4E5F\u662F\u7687\u5BB6\u8FD1\u536B\u519B\u4E2D\u552F\u4E00\u7684\u5973\u6027\u5251\u76FE\u7EDF\u9886\u3002\u867D\u7136\u5BB9\u8C8C\u5A07\u7F8E\uFF0C\u4F46\u5979\u7684\u5251\u672F\u5374\u662F\u5728\u65E0\u6570\u6B21\u8FB9\u5883\u6F14\u6B66\u4E2D\u78E8\u783A\u51FA\u6765\u7684\u94C1\u8840\u6D41\u6D3E\u3002\u5979\u8EAB\u7A7F\u7CBE\u7F8E\u7684\u8537\u8587\u767D\u91D1\u7532\uFF0C\u53F3\u624B\u6301\u4E00\u67C4\u950B\u5229\u65E0\u6BD4\u7684\u7687\u5BB6\u7EC6\u5251\uFF0C\u5DE6\u624B\u6301\u523B\u6709\u76FE\u5FBD\u7684\u8A93\u7EA6\u4E4B\u76FE\u3002\u4E3D\u5948\u7279\u5728\u6218\u573A\u4E0A\u5B9B\u5982\u9AD8\u50B2\u7EFD\u653E\u7684\u7EAF\u767D\u8537\u8587\uFF0C\u4E0D\u4EC5\u9632\u5B88\u6EF4\u6C34\u4E0D\u6F0F\uFF0C\u66F4\u80FD\u4EE5\u534E\u4E3D\u7684\u5251\u821E\u5728\u77AC\u606F\u95F4\u5207\u65AD\u654C\u4EBA\u7684\u5589\u5499\u3002                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      "
    heroSprite: {fileID: 21300000, guid: d80261d39b3dad9408b94c1cdf670eec, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a9302cc202dfa4e45afe3600dc2877da, type: 3}
    defaultUnlocked: 0
  - heroId: 6
    heroName: "\u5723\u5370\u5927\u796D\u53F8 \xB7 \u585E\u62C9\u83F2\u5A1C"
    heroDescription: "\u585E\u62C9\u83F2\u5A1C\u662F\u5E1D\u56FD\u7684\u56FD\u6559\u5723\u5973\uFF0C\u4EE3\u8868\u7740\u5B98\u65B9\u7684\u81F3\u9AD8\u4FE1\u4EF0\u3002\u5979\u65E0\u9700\u7A7F\u6234\u6C89\u91CD\u7684\u94C1\u7532\uFF0C\u4EC5\u51ED\u4E00\u4EF6\u7F16\u7EC7\u4E86\u91D1\u4E1D\u7B26\u6587\u7684\u7687\u5BB6\u5927\u796D\u53F8\u957F\u888D\uFF0C\u4FBF\u80FD\u514D\u53D7\u51E1\u4FD7\u5C18\u57C3\u4E0E\u90AA\u6076\u8BC5\u5492\u7684\u4FB5\u88AD\u3002\u5979\u624B\u4E2D\u7684\u201C\u5723\u5370\u5341\u5B57\u6756\u201D\u6563\u53D1\u7740\u6E29\u6696\u800C\u78C5\u7934\u7684\u751F\u547D\u80FD\u91CF\u3002\u4F5C\u4E3A\u6574\u652F\u52C7\u8005\u5927\u519B\u7684\u7EC8\u6781\u540E\u52E4\u4FDD\u969C\uFF0C\u585E\u62C9\u83F2\u5A1C\u7684\u4E00\u53E5\u7977\u8A00\u4FBF\u80FD\u8BA9\u5343\u519B\u4E07\u9A6C\u7684\u4F24\u52BF\u77AC\u95F4\u75CA\u6108\u3002\u5979\u662F\u58EB\u5175\u773C\u4E2D\u7684\u795E\u8FF9\u5316\u8EAB\uFF0C\u4E5F\u662F\u5E1D\u56FD\u4E0D\u706D\u7684\u5B88\u62A4\u6781\u661F\u3002"
    heroSprite: {fileID: 21300000, guid: ebf08b6401d2c29409584ec3d871027f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1defb35aad4e48245abf602bfede213c, type: 3}
    defaultUnlocked: 0
  - heroId: 7
    heroName: "\u9057\u8FF9\u5B66\u8005 \xB7 \u6258\u6797"
    heroDescription: "\u6258\u6797\u8868\u9762\u4E0A\u662F\u65E7\u4E66\u8857\u4E00\u5BB6\u6FD2\u4E34\u7834\u4EA7\u7684\u65E7\u4E66\u5E97\u8001\u677F\uFF0C\u6574\u5929\u6234\u7740\u5706\u6846\u773C\u955C\u3001\u62B1\u7740\u539A\u91CD\u7684\u53E4\u7C4D\u6253\u778C\u7761\u3002\u5B9E\u9645\u4E0A\uFF0C\u4ED6\u662F\u4E00\u4F4D\u72C2\u70ED\u7684\u201C\u6C11\u95F4\u53E4\u6587\u660E\u63A2\u9669\u5BB6\u201D\u3002\u4ED6\u8EAB\u4E0A\u7684\u7EFF\u888D\u91CC\u585E\u6EE1\u4E86\u5404\u79CD\u4ECE\u53E4\u4EE3\u9057\u8FF9\u4E2D\u6DD8\u6765\u7684\u9B54\u6CD5\u836F\u5242\uFF0C\u8170\u95F4\u548C\u978B\u5B50\u4E5F\u90FD\u662F\u7ED3\u5B9E\u7684\u65C5\u884C\u88C5\u675F\u3002\u4ED6\u624B\u4E2D\u7684\u201C\u85E4\u8513\u6676\u77F3\u6CD5\u6756\u201D\u4E0E\u53E6\u4E00\u53EA\u624B\u6367\u7740\u7684\u300A\u53E4\u8FF9\u5BC6\u5377\u300B\uFF0C\u80FD\u8BA9\u4ED6\u5F15\u5BFC\u51FA\u5931\u4F20\u7684\u53E4\u4EE3\u7B26\u6587\u9B54\u6CD5\u3002\u5F53\u5723\u5251\u53EC\u5524\u7684\u9B54\u7269\u5927\u519B\u7834\u574F\u4E86\u4ED6\u597D\u4E0D\u5BB9\u6613\u627E\u5230\u7684\u9057\u8FF9\u77F3\u7891\u65F6\uFF0C\u8FD9\u4F4D\u6E29\u548C\u7684\u5B66\u8005\u5F7B\u5E95\u6124\u6012\u4E86\u3002\u4ED6\u51B3\u5B9A\u5E26\u7740\u6EE1\u8EAB\u7684\u836F\u5242\u548C\u7981\u5FCC\u77E5\u8BC6\u8D70\u5411\u6218\u573A\u2014\u2014\u7528\u77E5\u8BC6\u7684\u529B\u91CF\uFF0C\u7ED9\u9B54\u7269\u4EEC\u4E0A\u4E00\u5802\u7269\u7406\u4E0E\u9B54\u6CD5\u7684\u53CC\u91CD\u89E3\u5256\u8BFE\u3002"
    heroSprite: {fileID: 21300000, guid: 3047b6a19e7618746af2c148ebfedb3f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 8917838ee30c134408dd00c82cd70f88, type: 3}
    defaultUnlocked: 0
  - heroId: 8
    heroName: "\u6E38\u8361\u4E4B\u5203 \xB7 \u7F57\u4F0A"
    heroDescription: "\u7F57\u4F0A\u662F\u4E00\u4E2A\u5C45\u65E0\u5B9A\u6240\u7684\u6D41\u6D6A\u5251\u5BA2\uFF0C\u9760\u5728\u5404\u5730\u7684\u9152\u9986\u63A5\u53D6\u60AC\u8D4F\u9B54\u7269\u7684\u59D4\u6258\u5EA6\u65E5\u3002\u4ED6\u8EAB\u7A7F\u4E00\u5957\u65E9\u5DF2\u892A\u8272\u7684\u7C97\u7CD9\u76AE\u7532\uFF0C\u5934\u53D1\u7528\u4E00\u6839\u8349\u7EF3\u968F\u610F\u624E\u8D77\u3002\u7F57\u4F0A\u7684\u773C\u795E\u4E2D\u5E26\u7740\u4E00\u79CD\u770B\u900F\u4E16\u6001\u708E\u51C9\u7684\u75B2\u60EB\uFF0C\u4F46\u4ED6\u624B\u4E2D\u7684\u7CBE\u94A2\u77ED\u5251\u5374\u6BD4\u4EFB\u4F55\u4EBA\u90FD\u5FEB\u3002\u4ED6\u4E0D\u76F8\u4FE1\u56FD\u5BB6\u7684\u5B98\u65B9\u5BA3\u4F20\uFF0C\u53EA\u76F8\u4FE1\u81EA\u5DF1\u624B\u4E2D\u7684\u77ED\u5251\u548C\u6000\u91CC\u7684\u9762\u5305\u3002\u5728\u6218\u573A\u4E0A\uFF0C\u4ED6\u5982\u540C\u4E00\u7F15\u5E02\u4E95\u7684\u98CE\uFF0C\u6E38\u8D70\u5728\u9634\u5F71\u4E0E\u6DF7\u4E71\u4E4B\u4E2D\uFF0C\u7ED9\u654C\u4EBA\u81F4\u547D\u4E00\u51FB\u3002"
    heroSprite: {fileID: 21300000, guid: 6380f5f94ca703a448fbab1c5cc68d61, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1197a2d2c7e59924795fcaabce05c278, type: 3}
    defaultUnlocked: 0
  - heroId: 9
    heroName: "\u7834\u65E7\u8A93\u8A00 \xB7 \u6C49\u65AF"
    heroDescription: "\u6C49\u65AF\u672C\u662F\u4E00\u4E2A\u968F\u5904\u53EF\u89C1\u7684\u843D\u9B44\u6D41\u6D6A\u6C49\uFF0C\u4E3A\u4E86\u6DF7\u53E3\u996D\u5403\u800C\u6210\u4E3A\u4E86\u6700\u5E95\u5C42\u7684\u96C7\u4F63\u5175\u3002\u4ED6\u7684\u62AB\u98CE\u65E9\u5DF2\u78E8\u635F\u5F97\u770B\u4E0D\u51FA\u539F\u672C\u7684\u989C\u8272\uFF0C\u94E0\u7532\u4E0A\u4E5F\u5E03\u6EE1\u4E86\u52A3\u8D28\u94C1\u9489\u548C\u4FEE\u8865\u7684\u75D5\u8FF9\u3002\u7136\u800C\uFF0C\u6B63\u662F\u8FD9\u6837\u4E00\u4E2A\u5728\u5E02\u4E95\u4E2D\u6478\u722C\u6EDA\u6253\u7684\u5BB6\u4F19\uFF0C\u5374\u5728\u751F\u6B7B\u5173\u5934\u89C9\u9192\u4E86\u8FDE\u4ED6\u81EA\u5DF1\u90FD\u4E0D\u6562\u76F8\u4FE1\u7684\u52C7\u8005\u4E4B\u529B\u3002\u6C49\u65AF\u867D\u7136\u6EE1\u5634\u5E02\u4E95\u4FCF\u76AE\u8BDD\uFF0C\u4F46\u5728\u6218\u573A\u4E0A\u4ED6\u6700\u61C2\u5F97\u5982\u4F55\u7528\u6700\u7701\u529B\u3001\u6700\u5B9E\u7528\u7684\u62DB\u5F0F\u6D3B\u4E0B\u6765\u3002\u4ED6\u5E38\u8BF4\uFF1A\u201C\u5927\u4EBA\u7269\u4E3A\u4E86\u8363\u8000\u800C\u6218\uFF0C\u6211\u53EA\u60F3\u8BA9\u5927\u5BB6\u90FD\u80FD\u6D3B\u7740\u56DE\u5BB6\u5403\u665A\u996D\u3002"
    heroSprite: {fileID: 21300000, guid: 407a578498353804e93ed1273305c3dd, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: ad54aa6591811174b88bbece43ee53a9, type: 3}
    defaultUnlocked: 0
  - heroId: 10
    heroName: "\u94DC\u5E01\u5F13\u624B \xB7 \u83B1\u7EB3"
    heroDescription: "\u83B1\u7EB3\u66FE\u662F\u57CE\u9632\u519B\u91CC\u4E00\u540D\u4E13\u95E8\u8D1F\u8D23\u770B\u5B88\u7CAE\u4ED3\u7684\u5C0F\u5352\uFF0C\u5E73\u65E5\u91CC\u6700\u5927\u7684\u7231\u597D\u5C31\u662F\u6570\u81EA\u5DF1\u7684\u6D25\u8D34\u94DC\u5E01\u3002\u4ED6\u9876\u7740\u4E00\u5934\u6742\u4E71\u7684\u77ED\u53D1\uFF0C\u8EAB\u7A7F\u7C97\u7CD9\u7684\u68C9\u7532\u3002\u4ED6\u624B\u4E2D\u7684\u94C1\u5F13\u751A\u81F3\u8FD8\u6709\u4E9B\u751F\u9508\uFF0C\u4F46\u83B1\u7EB3\u5BF9\u8DDD\u79BB\u548C\u98CE\u5411\u6709\u7740\u4E00\u79CD\u8FD1\u4E4E\u672C\u80FD\u7684\u5E02\u4E95\u7CBE\u660E\u3002\u4ED6\u4ECE\u4E0D\u548C\u654C\u4EBA\u6B63\u9762\u786C\u62FC\uFF0C\u800C\u662F\u627E\u4E2A\u9690\u853D\u7684\u8349\u5806\u6216\u5899\u89D2\uFF0C\u7528\u6700\u51B0\u51B7\u7684\u773C\u795E\u62C9\u52A8\u5F13\u5F26\u3002\u5BF9\u4ED6\u6765\u8BF4\uFF0C\u5C04\u6740\u4E00\u5934\u9B54\u7269\u5C31\u50CF\u5728\u96C6\u5E02\u4E0A\u505A\u4E86\u4E00\u7B14\u7A33\u8D5A\u4E0D\u8D54\u7684\u4E70\u5356\u3002"
    heroSprite: {fileID: 21300000, guid: c04e2be7f337b45448847b79cc9f9984, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 8cf7a8086b7835449ae583206e7b60ac, type: 3}
    defaultUnlocked: 0
  - heroId: 11
    heroName: "\u788E\u5CA9\u8005 \xB7 \u94C1\u725B"
    heroDescription: "\u94C1\u725B\u66FE\u662F\u4E2A\u91C7\u77F3\u573A\u7684\u82E6\u529B\uFF0C\u9664\u4E86\u6EE1\u8EAB\u7684\u8171\u5B50\u8089\u548C\u4E00\u628A\u7528\u6765\u788E\u77F3\u7684\u6D41\u661F\u9524\u5916\u4E00\u65E0\u6240\u6709\u3002\u4ED6\u5929\u751F\u4E0D\u7231\u8BF4\u8BDD\uFF0C\u5374\u6709\u7740\u725B\u4E00\u822C\u7684\u725B\u813E\u6C14\u3002\u4ED6\u90A3\u5934\u84DD\u53D1\u5728\u9633\u5149\u4E0B\u95EA\u95EA\u53D1\u4EAE\uFF0C\u8EAB\u4E0A\u7684\u76AE\u7532\u6839\u672C\u906E\u6321\u4E0D\u4F4F\u4ED6\u9686\u8D77\u7684\u808C\u8089\u3002\u94C1\u725B\u751A\u81F3\u4E0D\u61C2\u4EC0\u4E48\u662F\u201C\u52C7\u8005\u7684\u4F7F\u547D\u201D\uFF0C\u4ED6\u53EA\u77E5\u9053\u9B54\u7269\u8E29\u574F\u4E86\u4ED6\u8F9B\u8F9B\u82E6\u82E6\u5F00\u91C7\u7684\u77F3\u5934\u3002\u5F53\u4ED6\u6325\u52A8\u90A3\u628A\u51E0\u767E\u65A4\u91CD\u7684\u6D41\u661F\u9524\u65F6\uFF0C\u90A3\u79CD\u6392\u5C71\u5012\u6D77\u7684\u529B\u91CF\u751A\u81F3\u80FD\u8BA9\u5730\u8868\u4EA7\u751F\u88C2\u7EB9\uFF0C\u8FDE\u5DE8\u5927\u7684\u9B54\u517D\u4E5F\u4F1A\u88AB\u4ED6\u4E00\u9524\u7838\u5F97\u7C89\u788E\u3002"
    heroSprite: {fileID: 21300000, guid: 733da8621d19939429a2fa92b3b5f592, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 679fc04e8569a2841809f3eb6d197331, type: 3}
    defaultUnlocked: 0
  - heroId: 12
    heroName: "\u6DD8\u91D1\u8005 \xB7 \u8FEA\u514B"
    heroDescription: "\u8FEA\u514B\u539F\u672C\u662F\u6D3B\u8DC3\u5728\u5730\u4E0B\u77FF\u9053\u7684\u201C\u975E\u6CD5\u6DD8\u91D1\u8005\u201D\uFF0C\u4E00\u4E2A\u6389\u8FDB\u94B1\u773C\u91CC\u7684\u673A\u7075\u9B3C\u3002\u4ED6\u7684\u91D1\u53D1\u50CF\u4ED6\u7684\u6027\u683C\u4E00\u6837\u5F20\u626C\uFF0C\u8EAB\u4E0A\u6302\u6EE1\u4E86\u5404\u79CD\u4ECE\u5E9F\u589F\u91CC\u6DD8\u6765\u7684\u5C0F\u73A9\u610F\u548C\u9644\u9B54\u62A4\u8EAB\u7B26\u3002\u4ED6\u6325\u821E\u7740\u4E00\u5BF9\u7528\u6765\u5F00\u91C7\u77FF\u77F3\u7684\u77ED\u67C4\u6218\u9524\uFF0C\u867D\u7136\u770B\u8D77\u6765\u8EAB\u6750\u77EE\u5C0F\uFF0C\u4F46\u4ED6\u5BF9\u5730\u5E95\u548C\u5CA9\u77F3\u7684\u719F\u6089\u7A0B\u5EA6\u4E0D\u4E9A\u4E8E\u5C71\u4E2D\u6BBF\u5802\u7684\u77EE\u4EBA\u3002\u8FEA\u514B\u52A0\u5165\u52C7\u8005\u961F\u4F0D\u7684\u521D\u8877\u662F\u4E3A\u4E86\u9B54\u738B\u57CE\u5821\u91CC\u7684\u4F20\u8BF4\u5B9D\u85CF\uFF0C\u4F46\u4E00\u5230\u5173\u952E\u65F6\u523B\uFF0C\u8FD9\u4F4D\u5E02\u4E95\u51FA\u8EAB\u7684\u5BB6\u4F19\u603B\u4F1A\u4E00\u8FB9\u9A82\u9A82\u54A7\u54A7\uFF0C\u4E00\u8FB9\u7528\u6218\u9524\u7838\u788E\u654C\u4EBA\u7684\u8111\u888B\u3002"
    heroSprite: {fileID: 21300000, guid: e3a73cb9d0322b34e8da22de1f222feb, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: d08e4a0020353fd44a3076bdaed6a227, type: 3}
    defaultUnlocked: 0
  - heroId: 13
    heroName: "\u7FE0\u7FBD\u795E\u5C04 \xB7 \u83F2\u5965\u5A1C"
    heroDescription: "\u83F2\u5965\u5A1C\u662F\u4E16\u754C\u4E4B\u6811\u5B55\u80B2\u7684\u5996\u7CBE\u540E\u88D4\uFF0C\u62E5\u6709\u4EE4\u4EBA\u60CA\u53F9\u7684\u957F\u53D1\u4E0E\u7CBE\u7075\u822C\u654F\u9510\u7684\u89C6\u89C9\u3002\u5979\u8EAB\u7A7F\u7F00\u6EE1\u85E4\u8513\u82B1\u7EB9\u7684\u6797\u5730\u793C\u888D\uFF0C\u5728\u9519\u7EFC\u590D\u6742\u7684\u4E1B\u6797\u4E2D\u884C\u52A8\u5982\u98CE\u3002\u5979\u624B\u4E2D\u7684\u201C\u7FE0\u7FBD\u957F\u5F13\u201D\u7531\u4E07\u5E74\u53E4\u6728\u7684\u679D\u5E72\u4E0E\u72EC\u89D2\u517D\u7684\u9B03\u6BDB\u5236\u6210\uFF0C\u4E0D\u9700\u8981\u5B9E\u4F53\u7BAD\u77E2\u2014\u2014\u5F53\u5979\u62C9\u5F00\u5F13\u5F26\uFF0C\u7A7A\u6C14\u4E2D\u7684\u5FAE\u98CE\u4E0E\u8349\u6728\u9B54\u529B\u4F1A\u81EA\u52A8\u51DD\u805A\u6210\u65E0\u5F62\u4E14\u81F4\u547D\u7684\u81EA\u7136\u4E4B\u77E2\u3002\u5979\u7684\u7BAD\u4ECE\u4E0D\u865A\u53D1\uFF0C\u80FD\u5728\u6570\u91CC\u4E4B\u5916\u7CBE\u51C6\u8D2F\u7A7F\u9B54\u7269\u7684\u6838\u5FC3\uFF0C\u662F\u68EE\u6797\u6700\u5916\u56F4\u7684\u51B7\u9177\u5B88\u62A4\u8005\u3002"
    heroSprite: {fileID: 21300000, guid: fbd2c68c47519f446a1f2bd6899d1e8d, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: fdcb9b79aab9b904b8da8f416743c76b, type: 3}
    defaultUnlocked: 0
  - heroId: 14
    heroName: "\u7FE1\u7FE0\u8A93\u8A00 \xB7 \u585E\u897F\u8389\u4E9A"
    heroDescription: "\u4F5C\u4E3A\u6797\u95F4\u5723\u9A91\u58EB\u56E2\u7684\u5E74\u8F7B\u9886\u8896\uFF0C\u585E\u897F\u8389\u4E9A\u575A\u4FE1\u751F\u547D\u7684\u529B\u91CF\u9700\u8981\u94C1\u8840\u7684\u634D\u536B\u3002\u5979\u7559\u7740\u4E00\u5934\u5E72\u7EC3\u7684\u91D1\u8272\u77ED\u53D1\uFF0C\u8EAB\u62AB\u878D\u5165\u4E86\u7FE1\u7FE0\u94A2\u7684\u85E4\u7532\uFF0C\u624B\u4E2D\u7684\u7EC6\u5251\u4E0E\u76FE\u724C\u90FD\u523B\u6709\u8C61\u5F81\u81EA\u7136\u7684\u53E4\u8001\u5FBD\u8BB0\u3002\u585E\u897F\u8389\u4E9A\u4E0D\u4EC5\u5251\u672F\u5353\u8D8A\uFF0C\u66F4\u80FD\u5728\u6218\u6597\u4E2D\u5C06\u81EA\u7136\u7ED3\u754C\u9644\u7740\u5728\u76FE\u724C\u4E0A\uFF0C\u53CD\u5F39\u654C\u4EBA\u7684\u90AA\u6076\u9B54\u6CD5\u3002\u6BCF\u5F53\u5979\u9AD8\u4E3E\u957F\u5251\uFF0C\u6E29\u548C\u800C\u8000\u773C\u7684\u6CBB\u6108\u4E4B\u5149\u4FBF\u4F1A\u7B3C\u7F69\u6218\u573A\uFF0C\u6CBB\u6108\u540C\u4F34\u7684\u4F24\u75DB\u3002"
    heroSprite: {fileID: 21300000, guid: b542bcf46a868964281e445c0cd6b80a, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: b1df6714b0baf464e890312259db2fa5, type: 3}
    defaultUnlocked: 0
  - heroId: 15
    heroName: "\u5E7C\u72FC\u4E4B\u76FE \xB7 \u6D1B\u514B"
    heroDescription: "\u6D1B\u514B\u662F\u4E00\u540D\u7531\u5DE8\u72FC\u629A\u517B\u957F\u5927\u7684\u4E1B\u6797\u5B64\u513F\uFF0C\u5BF9\u68EE\u6797\u6709\u7740\u5F02\u4E8E\u5E38\u4EBA\u7684\u76F4\u89C9\u3002\u4ED6\u5E74\u7EAA\u867D\u5C0F\uFF0C\u5374\u62E5\u6709\u80FD\u4E0E\u767E\u517D\u6C9F\u901A\u7684\u5929\u8D4B\u3002\u4ED6\u6240\u6301\u6709\u7684\u5DE8\u578B\u9E22\u76FE\u4E0A\u96D5\u523B\u7740\u68EE\u6797\u4E4B\u72FC\u7684\u56FE\u817E\uFF0C\u90A3\u662F\u7531\u53E4\u6811\u4E4B\u7CBE\u8D60\u4E88\u4ED6\u7684\u9632\u5FA1\u5723\u7269\u3002\u6D1B\u514B\u5728\u6218\u573A\u4E0A\u4E3B\u8981\u8D1F\u8D23\u5438\u5F15\u9B54\u7269\u7684\u6CE8\u610F\uFF0C\u5E76\u7528\u575A\u4E0D\u53EF\u6467\u7684\u6728\u7075\u4E4B\u76FE\u4E3A\u8EAB\u540E\u7684\u6CD5\u5E08\u548C\u5C04\u624B\u63D0\u4F9B\u7EDD\u5BF9\u5B89\u5168\u7684\u8F93\u51FA\u73AF\u5883\u3002\u4ED6\u7684\u7B11\u5BB9\u603B\u662F\u5E26\u7740\u6797\u95F4\u9633\u5149\u822C\u7684\u6E29\u6696\uFF0C\u4F46\u4EFB\u4F55\u8BD5\u56FE\u4F24\u5BB3\u4ED6\u540C\u4F34\u7684\u654C\u4EBA\uFF0C\u90FD\u4F1A\u8FCE\u6765\u4ED6\u91CE\u6027\u7206\u53D1\u7684\u5236\u88C1\u3002"
    heroSprite: {fileID: 21300000, guid: 9e571f580cb74f04494dcb0483bc1e72, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: bf0afbc4a06216c41b249d70ff00abf0, type: 3}
    defaultUnlocked: 0
  - heroId: 16
    heroName: "\u4E07\u7269\u4F4E\u8BED \xB7 \u5E0C\u5C14\u5FAE"
    heroDescription: "\u5E0C\u5C14\u5FAE\u662F\u4E1B\u6797\u6DF1\u5904\u6700\u795E\u79D8\u7684\u767D\u53D1\u5723\u5973\uFF0C\u88AB\u8A89\u4E3A\u201C\u81EA\u7136\u7684\u4EE3\u8A00\u4EBA\u201D\u3002\u5979\u65E0\u9700\u541F\u5531\u7E41\u590D\u7684\u5492\u8BED\uFF0C\u53EA\u9700\u8F7B\u8F7B\u6325\u52A8\u70B9\u7F00\u7740\u5723\u6811\u7ED3\u6676\u7684\u201C\u4E07\u7269\u6CD5\u6756\u201D\uFF0C\u6216\u8005\u4F38\u51FA\u53F3\u624B\u4F4E\u8BED\uFF0C\u5468\u56F4\u7684\u690D\u7269\u4FBF\u4F1A\u5982\u540C\u62E5\u6709\u751F\u547D\u822C\u75AF\u72C2\u751F\u957F\u3002\u5979\u80FD\u53EC\u5524\u8346\u68D8\u56DA\u7262\u675F\u7F1A\u9B54\u738B\u7684\u5927\u519B\uFF0C\u4E5F\u80FD\u8BA9\u8352\u829C\u7684\u6B7B\u5730\u77AC\u95F4\u5F00\u6EE1\u5267\u6BD2\u7684\u5F7C\u5CB8\u82B1\u6D77\u3002\u5979\u90A3\u53CC\u6F84\u6F88\u7684\u7EFF\u8272\u773C\u7738\u4E2D\uFF0C\u8574\u542B\u7740\u5BF9\u751F\u547D\u7684\u65E0\u5C3D\u601C\u60AF\uFF0C\u4EE5\u53CA\u5BF9\u7834\u574F\u81EA\u7136\u8005\u7684\u6BC1\u706D\u5BA1\u5224\u3002"
    heroSprite: {fileID: 21300000, guid: fc2202960831ecd438b7ef5f1d2a36f3, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 543a04a98e8e58943bcbcb5502f11eb9, type: 3}
    defaultUnlocked: 0
  - heroId: 17
    heroName: "\u79D8\u6797\u8D24\u8005 \xB7 \u9732\u897F\u4E9A"
    heroDescription: "\u9732\u897F\u4E9A\u662F\u9690\u5C45\u5728\u53E4\u4EE3\u9057\u8FF9\u4E2D\u7684\u667A\u8005\uFF0C\u7EC8\u65E5\u4E0E\u53E4\u8001\u7684\u81EA\u7136\u9B54\u6CD5\u4E66\u4E3A\u4F34\u3002\u5979\u8EAB\u62AB\u80FD\u591F\u878D\u5165\u6797\u95F4\u9634\u5F71\u7684\u515C\u5E3D\u957F\u888D\uFF0C\u4E00\u624B\u63E1\u7740\u7FE1\u7FE0\u6CD5\u6756\uFF0C\u4E00\u624B\u6258\u7740\u8BB0\u8F7D\u4E86\u8FDC\u53E4\u7981\u5492\u7684\u300A\u7FE1\u7FE0\u5723\u5178\u300B\u3002\u9732\u897F\u4E9A\u7CBE\u901A\u5931\u4F20\u7684\u9635\u6CD5\u9B54\u6CD5\uFF0C\u968F\u7740\u5979\u7FFB\u52A8\u4E66\u9875\uFF0C\u6218\u573A\u4E0A\u4FBF\u4F1A\u4EAE\u8D77\u5DE8\u5927\u7684\u81EA\u7136\u7B26\u6587\u9635\u3002\u5979\u4E0D\u4EC5\u80FD\u501F\u7528\u6574\u7247\u68EE\u6797\u7684\u9B54\u529B\u6765\u538B\u5236\u654C\u4EBA\uFF0C\u8FD8\u80FD\u770B\u7A7F\u5BF9\u624B\u9B54\u6CD5\u7684\u6D41\u52A8\u4E0E\u7834\u7EFD\uFF0C\u662F\u6797\u95F4\u52C7\u8005\u4E2D\u6700\u4E3A\u535A\u5B66\u3001\u4E0D\u53EF\u6216\u7F3A\u7684\u6218\u672F\u6838\u5FC3\u3002"
    heroSprite: {fileID: 21300000, guid: 96b09b811b364bc40a3a415b7328505d, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 48b1e9c9c11c07849aca7e9bc1ca0e1d, type: 3}
    defaultUnlocked: 0
  - heroId: 18
    heroName: "\u6267\u5251\u8005 \xB7 \u6770\u897F\u5361"
    heroDescription: "\u6770\u897F\u5361\u662F\u6697\u6797\u536B\u961F\u7684\u4E00\u5458\uFF0C\u4E00\u4E2A\u6709\u4E9B\u5185\u5411\u5374\u6781\u5176\u8BA4\u771F\u7684\u5E74\u8F7B\u4EBA\u3002\u5979\u6CA1\u6709\u591A\u4F59\u7684\u4FEE\u9970\uFF0C\u53EA\u6709\u4E00\u8EAB\u98D8\u9038\u7684\u6218\u888D\u548C\u4E00\u628A\u4EE3\u4EE3\u76F8\u4F20\u7684\u53CC\u624B\u5927\u5251\u3002\u5F53\u9B54\u7269\u5927\u519B\u538B\u5883\uFF0C\u6B63\u89C4\u519B\u7EB7\u7EB7\u64A4\u9000\u65F6\uFF0C\u53EA\u6709\u6770\u897F\u5361\u548C\u4ED6\u7684\u6697\u6797\u540C\u4F34\u4EEC\u6B7B\u5B88\u5728\u6797\u95F4\u3002\u6770\u897F\u5361\u7684\u5251\u6CD5\u6CA1\u6709\u4EFB\u4F55\u534E\u4E3D\u7684\u5149\u6548\uFF0C\u6709\u7684\u53EA\u662F\u65E5\u590D\u4E00\u65E5\u6325\u5251\u4E0A\u4E07\u6B21\u78E8\u7EC3\u51FA\u6765\u7684\u521A\u731B\u4E0E\u51B3\u7EDD\u3002\u5979\u662F\u68EE\u6797\u52C7\u8005\u961F\u4F0D\u6700\u524D\u65B9\u7684\u80DC\u5229\u65D7\u5E1C\u3002"
    heroSprite: {fileID: 21300000, guid: 685c218c92a9fd54e82b9ef5335b9366, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 7734c8d5b857c884a8c9756eb09b372d, type: 3}
    defaultUnlocked: 0
  - heroId: 19
    heroName: "\u6C83\u91CE\u5B9D\u77F3 \xB7 \u7231\u4E3D\u871C\u69AD"
    heroDescription: "\u5927\u6CD5\u5E08\u7231\u4E3D\u871C\u69AD\u662F\u730E\u4EBA\u548C\u519C\u592B\u5BB6\u5EAD\u7684\u5B69\u5B50\uFF0C\u5C0F\u65F6\u5019\u7684\u4E00\u6B21\u5947\u9047\u8BA9\u5979\u5728\u9B54\u6CD5\u5B66\u9662\u6559\u6388\u83B1\u767B\u9762\u524D\u5C55\u73B0\u51FA\u4E86\u60CA\u4EBA\u7684\u6CD5\u672F\u5929\u8D4B\uFF0C\u5728\u8FD9\u4F4D\u5927\u6CD5\u5E08\u7684\u5F15\u5BFC\u4E0B\uFF0C\u5979\u4ECE\u6B64\u8D70\u4E0A\u4E86\u63A2\u7D22\u9B54\u6CD5\u9886\u57DF\u7684\u9053\u8DEF\u3002\u5728\u4EE5\u8D85\u4E4E\u5BFB\u5E38\u7684\u901F\u5EA6\u63D0\u524D\u5B8C\u6210\u5B66\u9662\u8BFE\u7A0B\u540E\uFF0C\u5979\u5E26\u7740\u5BF9\u6545\u571F\u7684\u6DF1\u5207\u611F\u60C5\uFF0C\u5C55\u5F00\u4E86\u5728\u4E61\u91CE\u95F4\u7684\u6E38\u5386\u3002\u4E0D\u77E5\u4ECE\u4F55\u65F6\u5F00\u59CB\uFF0C\u201C\u6C83\u91CE\u5B9D\u77F3\u201D\u8FD9\u4E2A\u540D\u53F7\u4ECE\u5F97\u5230\u4E86\u5979\u5E2E\u52A9\u7684\u4EBA\u4EEC\u53E3\u4E2D\u6D41\u4F20\u5F00\u6765\u3002\u65E9\u5728\u9B54\u65CF\u5927\u4E3E\u8FDB\u653B\u4E4B\u524D\u7684\u5F88\u591A\u5E74\uFF0C\u8FD9\u4F4D\u6DF1\u53D7\u6C11\u4F17\u559C\u7231\u7684\u5927\u6CD5\u5E08\u5C31\u5B88\u62A4\u7740\u738B\u56FD\u7684\u6C83\u571F\u3002"
    heroSprite: {fileID: 21300000, guid: 836980f1f62fbb445a6fadb135792639, type: 3}
    heroDetailSprite: {fileID: 0}
    defaultUnlocked: 0
  - heroId: 20
    heroName: "\u51B0\u6E0A\u6CD5\u5E08 \xB7 \u827E\u745E\u4E1D"
    heroDescription: "\u827E\u745E\u4E1D\u51FA\u8EAB\u4E8E\u5927\u9646\u6700\u5317\u7AEF\u7684\u6781\u5BD2\u8FB9\u5883\u2014\u2014\u51B0\u6E0A\u3002\u90A3\u91CC\u7EC8\u5E74\u88AB\u98CE\u96EA\u8986\u76D6\uFF0C\u53EA\u6709\u6700\u5F3A\u97E7\u7684\u751F\u547D\u624D\u80FD\u751F\u5B58\u3002\u5979\u5E76\u975E\u6B63\u7EDF\u51FA\u8EAB\u7684\u6CD5\u5E08\uFF0C\u800C\u662F\u901A\u8FC7\u611F\u77E5\u51B0\u6E0A\u6DF1\u5904\u7684\u9B54\u529B\u8109\u52A8\uFF0C\u65E0\u5E08\u81EA\u901A\u5730\u638C\u63E1\u4E86\u51B0\u96EA\u9B54\u6CD5\u3002\u5979\u624B\u4E2D\u7684\u201C\u51B0\u6E0A\u6CD5\u6756\u201D\u9876\u7AEF\u9576\u5D4C\u7740\u4E00\u9897\u5DE8\u5927\u7684\u3001\u4EFF\u4F5B\u6709\u751F\u547D\u822C\u8DF3\u52A8\u7684\u7D2B\u8272\u51B0\u6676\u3002\u5979\u80FD\u6781\u5176\u7CBE\u51C6\u5730\u64CD\u63A7\u51B0\u5143\u7D20\uFF0C\u5979\u7684\u9B54\u6CD5\u5982\u540C\u5979\u90A3\u6BEB\u65E0\u8868\u60C5\u7684\u8138\u5E9E\u4E00\u822C\u51B7\u9177\u4E14\u81F4\u547D\u3002\u867D\u7136\u770B\u8D77\u6765\u67D4\u5F31\uFF0C\u4F46\u4E00\u65E6\u5979\u91CA\u653E\u9B54\u6CD5\uFF0C\u6574\u4E2A\u6218\u573A\u90FD\u5C06\u77AC\u95F4\u51DD\u7ED3\u3002"
    heroSprite: {fileID: 21300000, guid: bf1d809243a97454a8df692024b6ad57, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 293f33efe75bf124bba3d285afcae7ad, type: 3}
    defaultUnlocked: 0
  - heroId: 21
    heroName: "\u788E\u51B0\u8005 \xB7 \u83B1\u6069"
    heroDescription: "\u83B1\u6069\u662F\u8FB9\u5883\u8981\u585E\u7684\u5B88\u536B\u8005\uFF0C\u4E00\u4E2A\u62E5\u6709\u7F55\u89C1\u7070\u8272\u957F\u53D1\u7684\u5F3A\u58EE\u6218\u58EB\u3002\u4ED6\u4ECE\u5C0F\u5C31\u5C55\u73B0\u51FA\u60CA\u4EBA\u7684\u529B\u91CF\uFF0C\u88AB\u5F53\u5730\u4EBA\u79F0\u4E3A\u201C\u788E\u51B0\u8005\u201D\u3002\u4ED6\u4E60\u60EF\u7A7F\u7740\u6C89\u91CD\u7684\u3001\u5E26\u6709\u51B0\u523A\u7684\u94E0\u7532\uFF0C\u8FD9\u4F7F\u4ED6\u5728\u6218\u573A\u4E0A\u5982\u540C\u7A7F\u68AD\u7684\u51B0\u5C71\u3002\u4ED6\u624B\u4E2D\u7684\u6218\u9524\u662F\u7531\u4E00\u5757\u4E0A\u53E4\u51B0\u6676\u96D5\u7422\u800C\u6210\uFF0C\u9524\u5934\u6563\u53D1\u7740\u5BD2\u6C14\u3002\u4ED6\u80FD\u5C06\u4F53\u5185\u7684\u72C2\u66B4\u9B54\u529B\u6CE8\u5165\u6218\u9524\u4E4B\u4E2D\uFF0C\u5F62\u6210\u6BC1\u706D\u6027\u7684\u6253\u51FB\u3002\u4ED6\u7684\u6027\u683C\u6B63\u5982\u4ED6\u7684\u5934\u53D1\u548C\u6218\u9524\uFF0C\u66B4\u8E81\u3001\u76F4\u63A5\u3001\u4E14\u5145\u6EE1\u4E86\u65E0\u53EF\u5339\u654C\u7684\u7834\u574F\u529B\u3002"
    heroSprite: {fileID: 21300000, guid: f831f8dd09b7f144489d07c691c6b085, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: ca3bb6fef2de6b7489d9b5d80588ad6b, type: 3}
    defaultUnlocked: 0
  - heroId: 22
    heroName: "\u5723\u5251\u9A91\u58EB \xB7 \u51EF"
    heroDescription: "\u51EF\u51FA\u8EAB\u4E8E\u8FB9\u5883\u5C0F\u6751\u5E84\uFF0C\u4E00\u4E2A\u666E\u901A\u7684\u5C11\u5E74\u3002\u5728\u4E00\u6B21\u9B54\u7269\u88AD\u51FB\u4E2D\uFF0C\u4ED6\u610F\u5916\u5524\u9192\u4E86\u4F20\u8BF4\u4E2D\u7684\u201C\u5723\u5251\u201D\u3002\u5723\u5251\u9009\u62E9\u4E86\u4ED6\uFF0C\u5E76\u8D4B\u4E88\u4E86\u4ED6\u5F3A\u5927\u7684\u5149\u5143\u7D20\u529B\u91CF\u3002\u51EF\u6C89\u9ED8\u5BE1\u8A00\uFF0C\u6BD4\u8D77\u6218\u672F\uFF0C\u4ED6\u66F4\u76F8\u4FE1\u7EDD\u5BF9\u7684\u6B63\u4E49\u3002\u5F53\u4ED6\u6325\u821E\u5723\u5251\uFF0C\u795E\u5723\u7684\u5149\u8292\u5C06\u6495\u88C2\u4E00\u5207\u963B\u6321\u4E4B\u7269\u3002\u4ED6\u7684\u76EE\u6807\u5F88\u7B80\u5355\uFF1A\u7528\u6700\u95EA\u8000\u7684\u5149\u8292\uFF0C\u9A71\u6563\u9B54\u738B\u7684\u9ED1\u6697\u3002"
    heroSprite: {fileID: 21300000, guid: 2fd06f172ffef5d4cab05b7053d2ee9e, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1844adfdb0c467148b3fa005851a66df, type: 3}
    defaultUnlocked: 0
  - heroId: 23
    heroName: "\u51B0\u7FCE\u795E\u5C04\u624B \xB7 \u9732\u5A1C"
    heroDescription: "\u9732\u5A1C\u662F\u8FB9\u5883\u6E38\u4FA0\uFF0C\u4E00\u4E2A\u62E5\u6709\u7F55\u89C1\u7070\u8272\u77ED\u53D1\u7684\u654F\u6377\u5C04\u624B\u3002\u5979\u4ECE\u5C0F\u5C31\u5C55\u73B0\u51FA\u60CA\u4EBA\u7684\u5C04\u51FB\u5929\u8D4B\uFF0C\u80FD\u5C06\u4F53\u5185\u7684\u51B0\u5143\u7D20\u6CE8\u5165\u7BAD\u77E2\u4E4B\u4E2D\uFF0C\u4F7F\u5176\u5E26\u6709\u51B0\u971C\u6548\u679C\u3002\u5979\u624B\u4E2D\u7684\u201C\u51B0\u7FCE\u5F13\u201D\u662F\u7531\u4E00\u6574\u5757\u4E0A\u53E4\u9B54\u6728\u96D5\u7422\u800C\u6210\uFF0C\u5F13\u8EAB\u548C\u7BAD\u77E2\u4E0A\u90FD\u5E26\u6709\u51B0\u7FCE\u56FE\u6848\u3002\u9732\u5A1C\u80FD\u6781\u5176\u7CBE\u51C6\u5730\u5C04\u51FB\uFF0C\u5979\u7684\u7BAD\u77E2\u5982\u540C\u5979\u7F16\u7EC7\u7684\u51B0\u6676\u4E00\u822C\u7CBE\u5BC6\u4E14\u81F4\u547D\u3002\u867D\u7136\u770B\u8D77\u6765\u6587\u5F31\uFF0C\u4F46\u4E00\u65E6\u5979\u62C9\u5F00\u5F13\uFF0C\u6574\u4E2A\u6218\u573A\u90FD\u5C06\u6210\u4E3A\u5979\u7684\u5C04\u51FB\u573A\u3002"
    heroSprite: {fileID: 21300000, guid: 0167370af45a85045b88d7a09bedaf8a, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 13772cf663d4f654ab1d9ea9752fef6d, type: 3}
    defaultUnlocked: 0
  - heroId: 24
    heroName: "\u8FB9\u585E\u96EA\u83B2 \xB7 \u585E\u4E3D\u5A1C"
    heroDescription: "\u585E\u4E3D\u5A1C\u662F\u8FB9\u5883\u8981\u585E\u53F8\u4EE4\u5B98\u7684\u5C0F\u5973\u513F\uFF0C\u51FA\u751F\u5728\u519B\u5B98\u4E16\u5BB6\u7684\u5979\u5374\u7CBE\u901A\u6CD5\u672F\u3002\u5979\u4ECE\u5E7C\u5E74\u8D77\u5C31\u5C55\u73B0\u51FA\u60CA\u4EBA\u7684\u9B54\u6CD5\u5929\u8D4B\uFF0C\u80FD\u591F\u5BF9\u591A\u79CD\u7C7B\u578B\u7684\u6CD5\u672F\u64CD\u63A7\u81EA\u5982\u3002\u968F\u7740\u5E74\u7EAA\u7684\u9010\u6E10\u589E\u52A0\uFF0C\u5979\u8EAB\u4E0A\u8574\u85CF\u7684\u9B54\u6CD5\u80FD\u91CF\u4E5F\u65E5\u76CA\u589E\u957F\uFF0C\u4E0D\u77E5\u4E0D\u89C9\u4E4B\u95F4\u5C3D\u597D\u4F3C\u8FB9\u585E\u7684\u6E56\u6C34\u4E00\u822C\u6DF1\u4E0D\u89C1\u5E95\u3002\u5979\u624B\u4E2D\u7684\u6CD5\u6756\u201C\u96EA\u83B2\u201D\u7531\u5979\u7684\u6069\u5E08\u2014\u2014\u738B\u56FD\u9996\u5E2D\u5927\u6CD5\u5E08\u6D1B\u745F\u6069\u5728\u9B54\u6CD5\u5B66\u9662\u7684\u6BD5\u4E1A\u4EEA\u5F0F\u4E0A\u4EB2\u81EA\u6388\u4E88\u3002\u5728\u5979\u7684\u5F3A\u529B\u652F\u6301\u4E0B\uFF0C\u8FB9\u5883\u8981\u585E\u5728\u9B54\u7269\u5982\u6F6E\u6C34\u822C\u7684\u653B\u51FB\u4E0B\u5B89\u7136\u65E0\u6059\u3002"
    heroSprite: {fileID: 21300000, guid: a65c5249d0a4a1444bc71595b566b1ca, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 953f7a3cf4a34b543acd79331120b7bd, type: 3}
    defaultUnlocked: 0
  - heroId: 25
    heroName: "\u88C2\u5CA9\u4E4B\u65A7 \xB7 \u683C\u7F57\u59C6"
    heroDescription: "\u683C\u7F57\u59C6\u4E0D\u4EC5\u662F\u5C71\u4E2D\u6BBF\u5802\u6700\u5F3A\u58EE\u7684\u6218\u58EB\uFF0C\u4E5F\u662F\u4E00\u4F4D\u5929\u751F\u7684\u7B26\u6587\u5DE5\u5320\u3002\u4ED6\u624B\u4E2D\u7684\u53CC\u5203\u6218\u65A7\u201C\u88C2\u5CA9\u201D\uFF0C\u5176\u4E0A\u9576\u5D4C\u7684\u7FE0\u7EFF\u5B9D\u77F3\u5E76\u975E\u51E1\u7269\uFF0C\u800C\u662F\u4ED6\u5728\u4E00\u6B21\u706B\u5C71\u6DF1\u5904\u7684\u63A2\u9669\u4E2D\uFF0C\u4ECE\u5CA9\u6D46\u5DE8\u517D\u5FC3\u53E3\u593A\u53D6\u7684\u201C\u5730\u8109\u6838\u5FC3\u201D\u3002\u901A\u8FC7\u6838\u5FC3\uFF0C\u4ED6\u80FD\u5C06\u4F53\u5185\u6F8E\u6E43\u7684\u6012\u706B\u8F6C\u5316\u4E3A\u7EAF\u7CB9\u7684\u70ED\u80FD\uFF0C\u6CE8\u5165\u65A7\u5203\u3002\u683C\u7F57\u59C6\u6C89\u9ED8\u5BE1\u8A00\uFF0C\u6BD4\u8D77\u6218\u672F\uFF0C\u4ED6\u66F4\u76F8\u4FE1\u7EDD\u5BF9\u7684\u529B\u91CF\u3002\u5F53\u4ED6\u6325\u821E\u6218\u65A7\uFF0C\u706B\u7130\u7684\u5F27\u5149\u5C06\u6495\u88C2\u4E00\u5207\u963B\u6321\u4E4B\u7269\u3002\u4ED6\u7684\u76EE\u6807\u5F88\u7B80\u5355\uFF1A\u7528\u6700\u70BD\u70ED\u7684\u706B\u7130\uFF0C\u878D\u5316\u9B54\u738B\u7684\u9ED1\u6697\u3002"
    heroSprite: {fileID: 21300000, guid: 58a333a546b0193408a3187d85b48f24, type: 3}
