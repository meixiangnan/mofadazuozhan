  - heroId: 3
    heroName: "\u7F57\u5BBE"
    heroDescription: "\u7F57\u5BBE\u662F\u738B\u56FD\u5DE1\u67E5\u961F\u4E2D\u7684\u5F13\u7BAD\u624B\uFF0C\u957F\u671F\u8D1F\u8D23\u91CE\u5916\u5DE1\u67E5\u548C\u8DEF\u7EBF\u89C2\u5BDF\u3002\u4ED6\u7559\u7740\u7070\u8272\u77ED\u53D1\uFF0C\u76EE\u5149\u654F\u9510\uFF0C\u5584\u4E8E\u53D1\u73B0\u9053\u8DEF\u3001\u6811\u6797\u548C\u57CE\u9547\u5468\u8FB9\u7684\u7EC6\u8282\u53D8\u5316\u3002\u7F57\u5BBE\u4F7F\u7528\u4E00\u628A\u8F7B\u4FBF\u957F\u5F13\uFF0C\u884C\u52A8\u7075\u6D3B\uFF0C\u9002\u5408\u5728\u590D\u6742\u5730\u5F62\u4E2D\u6267\u884C\u89C2\u5BDF\u548C\u8054\u7EDC\u4EFB\u52A1\u3002\u738B\u56FD\u5404\u5730\u51FA\u73B0\u5F02\u5E38\u60C5\u51B5\u540E\uFF0C\u4ED6\u4E3B\u52A8\u53C2\u4E0E\u8C03\u67E5\u5DE5\u4F5C\uFF0C\u534F\u52A9\u73A9\u5BB6\u6536\u96C6\u7EBF\u7D22\uFF0C\u5224\u65AD\u5B89\u5168\u8DEF\u7EBF\u3002"
