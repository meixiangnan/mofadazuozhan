  - heroId: 14
    heroName: "\u585E\u897F\u8389\u4E9A"
    heroDescription: "\u585E\u897F\u8389\u4E9A\u662F\u6797\u5730\u533A\u57DF\u7684\u5E74\u8F7B\u5DE1\u62A4\u8005\uFF0C\u957F\u671F\u8D1F\u8D23\u7EF4\u62A4\u6797\u95F4\u9053\u8DEF\u548C\u8BB0\u5F55\u690D\u7269\u751F\u957F\u60C5\u51B5\u3002\u5979\u7559\u7740\u91D1\u8272\u77ED\u53D1\uFF0C\u8EAB\u7A7F\u5E26\u6709\u85E4\u8513\u7EB9\u6837\u7684\u8F7B\u7532\uFF0C\u624B\u6301\u7EC6\u5251\u4E0E\u76FE\u724C\uFF0C\u76FE\u9762\u523B\u6709\u8C61\u5F81\u81EA\u7136\u7684\u53F6\u7247\u56FE\u6848\u3002\u585E\u897F\u8389\u4E9A\u6027\u683C\u575A\u5B9A\uFF0C\u505A\u4E8B\u8BA4\u771F\uFF0C\u65E2\u719F\u6089\u5251\u76FE\u8BAD\u7EC3\uFF0C\u4E5F\u4E86\u89E3\u6797\u5730\u4E2D\u7684\u57FA\u672C\u9632\u62A4\u6CD5\u672F\u3002\u5979\u4E60\u60EF\u5728\u51FA\u53D1\u524D\u68C0\u67E5\u9053\u8DEF\u3001\u5929\u6C14\u548C\u968F\u884C\u7269\u54C1\uFF0C\u786E\u4FDD\u540C\u884C\u8005\u80FD\u591F\u987A\u5229\u7A7F\u8FC7\u590D\u6742\u7684\u68EE\u6797\u5730\u5E26\u3002"
    heroSprite: {fileID: 21300000, guid: b542bcf46a868964281e445c0cd6b80a, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: b1df6714b0baf464e890312259db2fa5, type: 3}
    defaultUnlocked: 0
  - heroId: 15
    heroName: "\u6D1B\u514B"
    heroDescription: "\u6D1B\u514B\u4ECE\u5C0F\u751F\u6D3B\u5728\u6797\u5730\u533A\u57DF\uFF0C\u5BF9\u68EE\u6797\u4E2D\u7684\u9053\u8DEF\u3001\u6C14\u5473\u548C\u52A8\u7269\u4E60\u6027\u975E\u5E38\u719F\u6089\u3002\u4ED6\u5E74\u7EAA\u4E0D\u5927\uFF0C\u6027\u683C\u5F00\u6717\uFF0C\u5E38\u5E26\u7740\u4E00\u9762\u523B\u6709\u661F\u7EB9\u7684\u5927\u76FE\u3002\u6D1B\u514B\u884C\u52A8\u654F\u6377\uFF0C\u4E5F\u5F88\u64C5\u957F\u5728\u6811\u6797\u4E2D\u8FA8\u8BA4\u65B9\u5411\u3002\u9047\u5230\u964C\u751F\u8DEF\u5F84\u65F6\uFF0C\u4ED6\u4F1A\u901A\u8FC7\u6811\u76AE\u75D5\u8FF9\u3001\u8349\u53F6\u5012\u4F0F\u548C\u52A8\u7269\u7559\u4E0B\u7684\u811A\u5370\u5224\u65AD\u524D\u65B9\u60C5\u51B5\u3002\u867D\u7136\u4ED6\u5E73\u65F6\u8BF4\u8BDD\u76F4\u63A5\uFF0C\u4F46\u5F88\u91CD\u89C6\u540C\u884C\u8005\u7684\u5B89\u5168\uFF0C\u603B\u4F1A\u4E3B\u52A8\u8D70\u5728\u961F\u4F0D\u524D\u65B9\uFF0C\u786E\u8BA4\u9053\u8DEF\u662F\u5426\u9002\u5408\u901A\u884C\u3002"
    heroSprite: {fileID: 21300000, guid: 9e571f580cb74f04494dcb0483bc1e72, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: bf0afbc4a06216c41b249d70ff00abf0, type: 3}
    defaultUnlocked: 0
  - heroId: 16
    heroName: "\u5E0C\u5C14\u5FAE"
    heroDescription: "\u5E0C\u5C14\u5FAE\u751F\u6D3B\u5728\u4E1B\u6797\u6DF1\u5904\uFF0C\u719F\u6089\u5404\u79CD\u690D\u7269\u7684\u751F\u957F\u4E60\u6027\u548C\u6797\u5730\u73AF\u5883\u53D8\u5316\u3002\u5979\u6709\u4E00\u5934\u767D\u8272\u957F\u53D1\uFF0C\u773C\u7738\u6E05\u6F88\uFF0C\u8EAB\u7A7F\u5E26\u6709\u53F6\u7247\u7EB9\u6837\u7684\u957F\u888D\uFF0C\u624B\u6301\u4E00\u67C4\u70B9\u7F00\u7EFF\u8272\u6676\u77F3\u7684\u6CD5\u6756\u3002\u5E0C\u5C14\u5FAE\u6027\u683C\u5B89\u9759\uFF0C\u559C\u6B22\u89C2\u5BDF\u82B1\u8349\u3001\u6811\u6728\u548C\u6C34\u6E90\u7684\u7EC6\u5FAE\u53D8\u5316\uFF0C\u4E5F\u64C5\u957F\u4F7F\u7528\u4E0E\u690D\u7269\u6709\u5173\u7684\u81EA\u7136\u6CD5\u672F\u3002\u5979\u80FD\u591F\u5F15\u5BFC\u85E4\u8513\u548C\u679D\u53F6\u4FEE\u6574\u9053\u8DEF\uFF0C\u5E2E\u52A9\u53D7\u635F\u7684\u6797\u5730\u91CD\u65B0\u6062\u590D\u751F\u673A\u3002\u8BB8\u591A\u6797\u95F4\u5C0F\u8DEF\u539F\u672C\u5DF2\u7ECF\u88AB\u8349\u6728\u906E\u4F4F\uFF0C\u7ECF\u5979\u6574\u7406\u540E\uFF0C\u53C8\u80FD\u91CD\u65B0\u9732\u51FA\u6E05\u6670\u7684\u65B9\u5411\u3002"
    heroSprite: {fileID: 21300000, guid: fc2202960831ecd438b7ef5f1d2a36f3, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 543a04a98e8e58943bcbcb5502f11eb9, type: 3}
    defaultUnlocked: 0
  - heroId: 17
    heroName: "\u9732\u897F\u4E9A"
    heroDescription: "\u9732\u897F\u4E9A\u957F\u671F\u5C45\u4F4F\u5728\u53E4\u4EE3\u9057\u8FF9\u9644\u8FD1\uFF0C\u559C\u6B22\u7814\u7A76\u81EA\u7136\u6CD5\u672F\u4E66\u548C\u65E7\u65F6\u4EE3\u7559\u4E0B\u7684\u7B26\u6587\u8D44\u6599\u3002\u5979\u8EAB\u62AB\u5E26\u515C\u5E3D\u7684\u957F\u888D\uFF0C\u624B\u6301\u7FE1\u7FE0\u8272\u6CD5\u6756\uFF0C\u968F\u8EAB\u643A\u5E26\u4E00\u672C\u8BB0\u5F55\u7B26\u6587\u56FE\u6848\u7684\u53E4\u4E66\u3002\u9732\u897F\u4E9A\u6027\u683C\u6C89\u9759\uFF0C\u5584\u4E8E\u9605\u8BFB\u590D\u6742\u7684\u56FE\u6848\u548C\u6587\u5B57\uFF0C\u4E5F\u80FD\u4ECE\u9057\u8FF9\u5899\u9762\u3001\u77F3\u67F1\u7EB9\u8DEF\u548C\u6B8B\u7F3A\u5377\u9875\u4E2D\u6574\u7406\u51FA\u6709\u7528\u7684\u4FE1\u606F\u3002\u5979\u5BF9\u9635\u6CD5\u4E0E\u81EA\u7136\u6CD5\u672F\u6709\u8F83\u6DF1\u4E86\u89E3\uFF0C\u5E38\u7528\u81EA\u5DF1\u7684\u7B14\u8BB0\u8FD8\u539F\u88AB\u9057\u5FD8\u7684\u8DEF\u7EBF\u548C\u573A\u666F\u7ED3\u6784\u3002"
    heroSprite: {fileID: 21300000, guid: 96b09b811b364bc40a3a415b7328505d, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 48b1e9c9c11c07849aca7e9bc1ca0e1d, type: 3}
    defaultUnlocked: 0
  - heroId: 18
    heroName: "\u6770\u897F\u5361"
    heroDescription: "\u6770\u897F\u5361\u662F\u6797\u5730\u5DE1\u62A4\u961F\u7684\u4E00\u5458\uFF0C\u6027\u683C\u5185\u5411\uFF0C\u4F46\u505A\u4E8B\u8BA4\u771F\u3002\u5979\u5E73\u65F6\u7A7F\u7740\u4FBF\u4E8E\u884C\u52A8\u7684\u6DF1\u8272\u957F\u888D\uFF0C\u968F\u8EAB\u643A\u5E26\u4E00\u67C4\u53CC\u624B\u5927\u5251\u3002\u6770\u897F\u5361\u4E0D\u559C\u6B22\u8FC7\u591A\u4FEE\u9970\uFF0C\u4E5F\u5F88\u5C11\u5938\u8000\u81EA\u5DF1\u7684\u80FD\u529B\u3002\u5979\u66F4\u4E60\u60EF\u628A\u65F6\u95F4\u7528\u5728\u65E5\u5E38\u8BAD\u7EC3\u3001\u9053\u8DEF\u5DE1\u67E5\u548C\u8BB0\u5F55\u6797\u95F4\u53D8\u5316\u4E0A\u3002\u5979\u7684\u5251\u672F\u98CE\u683C\u76F4\u63A5\u7A33\u5065\uFF0C\u6CA1\u6709\u590D\u6742\u82B1\u6837\uFF0C\u4E3B\u8981\u4F9D\u9760\u957F\u671F\u7EC3\u4E60\u5F62\u6210\u7684\u529B\u91CF\u4E0E\u8282\u594F\u3002\u9047\u5230\u9700\u8981\u5F00\u8DEF\u3001\u62A4\u9001\u6216\u7EF4\u6301\u79E9\u5E8F\u7684\u60C5\u51B5\u65F6\uFF0C\u5979\u603B\u662F\u5B89\u9759\u5730\u7AD9\u5230\u6700\u524D\u9762\u3002"
    heroSprite: {fileID: 21300000, guid: 685c218c92a9fd54e82b9ef5335b9366, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 7734c8d5b857c884a8c9756eb09b372d, type: 3}
    defaultUnlocked: 0
  - heroId: 19
    heroName: "\u7231\u4E3D\u871C\u69AD"
    heroDescription: "\u7231\u4E3D\u871C\u69AD\u51FA\u751F\u5728\u4E61\u91CE\u5730\u533A\uFF0C\u7236\u6BCD\u4EE5\u519C\u8015\u548C\u72E9\u730E\u7EF4\u6301\u751F\u6D3B\u3002\u5979\u4ECE\u5C0F\u719F\u6089\u7530\u91CE\u3001\u6797\u5730\u548C\u6751\u5E84\u9053\u8DEF\uFF0C\u4E5F\u5BF9\u81EA\u7136\u73B0\u8C61\u6709\u5F88\u5F3A\u7684\u89C2\u5BDF\u529B\u3002\u4E00\u6B21\u5076\u7136\u7ECF\u5386\u4E2D\uFF0C\u5979\u5C55\u73B0\u51FA\u5B66\u4E60\u6CD5\u672F\u7684\u5929\u8D4B\uFF0C\u5E76\u5728\u83B1\u767B\u7684\u5F15\u5BFC\u4E0B\u5F00\u59CB\u63A5\u89E6\u7CFB\u7EDF\u7684\u6CD5\u672F\u77E5\u8BC6\u3002\u5B8C\u6210\u5B66\u9662\u8BFE\u7A0B\u540E\uFF0C\u7231\u4E3D\u871C\u69AD\u6CA1\u6709\u957F\u671F\u7559\u5728\u57CE\u4E2D\uFF0C\u800C\u662F\u9009\u62E9\u56DE\u5230\u4E61\u91CE\u4E4B\u95F4\u6E38\u5386\u3002\u5979\u5E38\u5E2E\u52A9\u6751\u6C11\u6574\u7406\u6C34\u6E20\u3001\u8BB0\u5F55\u4F5C\u7269\u751F\u957F\u60C5\u51B5\uFF0C\u4E5F\u4F1A\u8FD0\u7528\u57FA\u7840\u6CD5\u672F\u534F\u52A9\u5904\u7406\u519C\u7530\u548C\u9053\u8DEF\u4E2D\u7684\u95EE\u9898\u3002\u5BF9\u5979\u6765\u8BF4\uFF0C\u5E7F\u9614\u7684\u7530\u91CE\u4E0D\u53EA\u662F\u6545\u4E61\uFF0C\u4E5F\u662F\u5979\u6700\u719F\u6089\u3001\u6700\u613F\u610F\u5B88\u62A4\u7684\u5730\u65B9\u3002"
    heroSprite: {fileID: 21300000, guid: 836980f1f62fbb445a6fadb135792639, type: 3}
    heroDetailSprite: {fileID: 0}
    defaultUnlocked: 0
  - heroId: 20
    heroName: "\u827E\u745E\u4E1D"
    heroDescription: "\u827E\u745E\u4E1D\u6765\u81EA\u5927\u9646\u5317\u7AEF\u7684\u51B0\u539F\u5730\u533A\uFF0C\u90A3\u91CC\u5E38\u5E74\u5BD2\u51B7\uFF0C\u98CE\u96EA\u9891\u7E41\u3002\u5979\u5E76\u975E\u4F20\u7EDF\u5B66\u9662\u51FA\u8EAB\u7684\u6CD5\u5E08\uFF0C\u800C\u662F\u5728\u957F\u671F\u89C2\u5BDF\u51B0\u96EA\u3001\u5BD2\u98CE\u548C\u5730\u5F62\u53D8\u5316\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u9010\u6E10\u638C\u63E1\u4E86\u4E0E\u51B0\u96EA\u6709\u5173\u7684\u6CD5\u672F\u77E5\u8BC6\u3002\u827E\u745E\u4E1D\u624B\u6301\u4E00\u67C4\u9576\u5D4C\u7D2B\u8272\u51B0\u6676\u7684\u6CD5\u6756\uFF0C\u8863\u7740\u4EE5\u6D45\u8272\u548C\u84DD\u7D2B\u8272\u4E3A\u4E3B\uFF0C\u6574\u4F53\u6C14\u8D28\u5B89\u9759\u51B7\u6DE1\u3002\u5979\u64C5\u957F\u5224\u65AD\u4F4E\u6E29\u73AF\u5883\u4E0B\u7684\u9053\u8DEF\u53D8\u5316\uFF0C\u4E5F\u80FD\u5229\u7528\u51B0\u96EA\u6CD5\u672F\u6807\u8BB0\u8DEF\u5F84\u3001\u7A33\u5B9A\u5730\u9762\u548C\u6574\u7406\u88AB\u98CE\u96EA\u8986\u76D6\u7684\u7EBF\u7D22\u3002\u522B\u4EBA\u773C\u4E2D\u7684\u8352\u5BD2\u4E4B\u5730\uFF0C\u5728\u5979\u770B\u6765\u6709\u7740\u6E05\u6670\u7684\u5C42\u6B21\u548C\u89C4\u5F8B\u3002"
    heroSprite: {fileID: 21300000, guid: bf1d809243a97454a8df692024b6ad57, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 293f33efe75bf124bba3d285afcae7ad, type: 3}
    defaultUnlocked: 0
  - heroId: 21
    heroName: "\u83B1\u6069"
    heroDescription: "\u83B1\u6069\u6765\u81EA\u5317\u5883\u8FB9\u5883\u8981\u585E\uFF0C\u662F\u5F53\u5730\u5B88\u536B\u961F\u4E2D\u7684\u6210\u5458\u3002\u4ED6\u6709\u4E00\u5934\u5C11\u89C1\u7684\u7070\u8272\u957F\u53D1\uFF0C\u8EAB\u6750\u9AD8\u5927\uFF0C\u5E38\u7A7F\u5E26\u6709\u51B0\u6676\u88C5\u9970\u7684\u539A\u91CD\u94E0\u7532\u3002\u83B1\u6069\u624B\u6301\u4E00\u67C4\u51B0\u6676\u6218\u9524\uFF0C\u9524\u5934\u5E26\u6709\u6DE1\u6DE1\u5BD2\u6C14\uFF0C\u6574\u4F53\u9020\u578B\u6C89\u7A33\u800C\u9192\u76EE\u3002\u4ED6\u6027\u683C\u76F4\u63A5\uFF0C\u4E0D\u64C5\u957F\u7ED5\u5F2F\uFF0C\u4F46\u505A\u4E8B\u53EF\u9760\uFF0C\u9047\u5230\u56F0\u96BE\u65F6\u5F88\u5C11\u9000\u7F29\u3002\u957F\u671F\u5728\u5BD2\u51B7\u5730\u533A\u751F\u6D3B\u7684\u7ECF\u5386\uFF0C\u8BA9\u4ED6\u719F\u6089\u51B0\u9762\u3001\u5C71\u9053\u548C\u8981\u585E\u5468\u8FB9\u7684\u5730\u5F62\u53D8\u5316\u3002\u9047\u5230\u88AB\u51B0\u96EA\u8986\u76D6\u7684\u9053\u8DEF\u65F6\uFF0C\u4ED6\u603B\u80FD\u5224\u65AD\u51FA\u66F4\u7A33\u59A5\u7684\u901A\u884C\u65B9\u5F0F\u3002"
    heroSprite: {fileID: 21300000, guid: f831f8dd09b7f144489d07c691c6b085, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: ca3bb6fef2de6b7489d9b5d80588ad6b, type: 3}
    defaultUnlocked: 0
  - heroId: 22
    heroName: "\u51EF"
    heroDescription: "\u51EF\u6765\u81EA\u8FB9\u5883\u5730\u533A\u7684\u4E00\u4E2A\u5C0F\u6751\u5E84\uFF0C\u662F\u4E00\u540D\u6027\u683C\u6C89\u7A33\u7684\u5C11\u5E74\u3002\u4ED6\u5E73\u65F6\u8BDD\u4E0D\u591A\uFF0C\u4F46\u505A\u4E8B\u8BA4\u771F\uFF0C\u5BF9\u5BB6\u4E61\u7684\u9053\u8DEF\u3001\u519C\u7530\u548C\u5C71\u5761\u90FD\u5F88\u719F\u6089\u3002\u4E00\u6B21\u5076\u7136\u7ECF\u5386\u4E2D\uFF0C\u51EF\u53D1\u73B0\u81EA\u5DF1\u80FD\u591F\u611F\u77E5\u5230\u5FAE\u5F31\u7684\u5149\u5143\u7D20\uFF0C\u5E76\u9010\u6E10\u5B66\u4F1A\u5C06\u8FD9\u79CD\u529B\u91CF\u7528\u4E8E\u7167\u660E\u3001\u6307\u5F15\u65B9\u5411\u548C\u6807\u8BB0\u9053\u8DEF\u3002\u4ED6\u968F\u8EAB\u643A\u5E26\u4E00\u67C4\u9020\u578B\u6734\u7D20\u7684\u957F\u5251\uFF0C\u5251\u8EAB\u5E38\u5E26\u6709\u67D4\u548C\u7684\u5149\u8292\u3002\u51EF\u4E0D\u559C\u6B22\u5938\u8000\u81EA\u5DF1\u7684\u80FD\u529B\uFF0C\u4E5F\u5F88\u5C11\u4E3B\u52A8\u7AD9\u5230\u4EBA\u7FA4\u4E2D\u592E\u3002"
    heroSprite: {fileID: 21300000, guid: 2fd06f172ffef5d4cab05b7053d2ee9e, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1844adfdb0c467148b3fa005851a66df, type: 3}
