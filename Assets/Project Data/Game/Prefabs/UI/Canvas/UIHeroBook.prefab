    defaultUnlocked: 0
  - heroId: 26
    heroName: "\u7834\u6653\u4E4B\u9524 \xB7 \u5DF4\u6797"
    heroDescription: "\u5DF4\u6797\u662F\u6BBF\u5802\u4E2D\u6700\u8654\u8BDA\u7684\u5B88\u62A4\u8005\uFF0C\u4ED6\u6DF1\u4FE1\u5149\u660E\u7684\u529B\u91CF\u7EC8\u5C06\u9A71\u6563\u9ED1\u6697\u3002\u4ED6\u7684\u5934\u76D4\u7531\u5C71\u4E2D\u7279\u6709\u7684\u8010\u706B\u7CBE\u91D1\u6253\u9020\uFF0C\u80FD\u62B5\u5FA1\u6700\u731B\u70C8\u7684\u9B54\u6CD5\u706B\u7130\u3002\u4ED6\u624B\u4E2D\u7684\u201C\u7834\u6653\u4E4B\u9524\u201D\uFF0C\u5176\u9524\u5934\u662F\u4E00\u5757\u9668\u843D\u7684\u661F\u8FB0\uFF0C\u5728\u77EE\u4EBA\u957F\u8FBE\u767E\u5E74\u7684\u953B\u9020\u4E0B\uFF0C\u7EC8\u65E5\u6563\u53D1\u7740\u5982\u540C\u65ED\u65E5\u822C\u6E29\u548C\u5374\u4E0D\u53EF\u5C0F\u89D1\u7684\u91D1\u5149\u3002\u5DF4\u6797\u4E0D\u4EC5\u80FD\u7528\u6218\u9524\u51FB\u788E\u654C\u4EBA\u7684\u62A4\u7532\uFF0C\u66F4\u80FD\u6FC0\u53D1\u5176\u4E2D\u7684\u795E\u5723\u529B\u91CF\uFF0C\u6CBB\u7597\u540C\u4F34\u6216\u4E3A\u4ED6\u4EEC\u65BD\u52A0\u5149\u4E4B\u62A4\u76FE\u3002\u4ED6\u662F\u6218\u573A\u4E0A\u6700\u7A33\u56FA\u7684\u5821\u5792\uFF0C\u662F\u540C\u4F34\u5FC3\u4E2D\u4E0D\u706D\u7684\u5E0C\u671B\u3002"
    heroSprite: {fileID: 21300000, guid: f521e18b84439e24a9b2ab56ff8cfc62, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 516559a19feccc6439e7daa2bdb08f35, type: 3}
    defaultUnlocked: 0
  - heroId: 27
    heroName: "\u6676\u8000\u6CD5\u5E08 \xB7 \u827E\u745E\u514B"
    heroDescription: "\u827E\u745E\u514B\u662F\u4E00\u4F4D\u7F55\u89C1\u7684\u77EE\u4EBA\u6CD5\u5E08\uFF0C\u4ED6\u6452\u5F03\u4E86\u4F20\u7EDF\u7684\u91D1\u5C5E\u953B\u9020\uFF0C\u8F6C\u800C\u94BB\u7814\u6DF1\u5C71\u6676\u77F3\u4E2D\u8574\u542B\u7684\u53E4\u8001\u9B54\u6CD5\u3002\u4ED6\u624B\u4E2D\u7684\u201C\u6676\u8000\u6CD5\u6756\u201D\u662F\u7531\u4E00\u6574\u5757\u4E0A\u53E4\u9B54\u6676\u96D5\u7422\u800C\u6210\uFF0C\u9876\u7AEF\u4E0D\u4EC5\u9576\u5D4C\u7740\u4E00\u9897\u5DE8\u5927\u7684\u3001\u4EFF\u4F5B\u6709\u751F\u547D\u822C\u8DF3\u52A8\u7684\u5965\u672F\u6676\u77F3\uFF0C\u8FD8\u60AC\u6302\u7740\u80FD\u591F\u589E\u5E45\u6CD5\u529B\u7684\u7B26\u6587\u9501\u94FE\u3002\u827E\u745E\u514B\u80FD\u6781\u5176\u7CBE\u51C6\u5730\u64CD\u63A7\u5404\u79CD\u5143\u7D20\uFF0C\u4ED6\u7684\u6CD5\u672F\u5982\u540C\u4ED6\u7F16\u7EC7\u7684\u6676\u4F53\u4E00\u822C\u7CBE\u5BC6\u4E14\u81F4\u547D\u3002\u867D\u7136\u770B\u8D77\u6765\u6587\u5F31\uFF0C\u4F46\u4E00\u65E6\u4ED6\u6325\u821E\u6CD5\u6756\uFF0C\u6574\u4E2A\u6218\u573A\u90FD\u5C06\u6210\u4E3A\u4ED6\u7684\u9B54\u6CD5\u8BD5\u9A8C\u573A\u3002"
    heroSprite: {fileID: 21300000, guid: a3dad200307ee0b4d955ea7d6656117f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 69ece6436e075b446b9dcbfdc16baac2, type: 3}
    defaultUnlocked: 0
  - heroId: 28
    heroName: "\u7EEF\u7EA2\u6012\u706B \xB7 \u7D22\u5C14"
    heroDescription: "\u7D22\u5C14\u662F\u6BBF\u5802\u4E2D\u7684\u5F02\u7C7B\uFF0C\u4E00\u4E2A\u62E5\u6709\u7F55\u89C1\u9C9C\u8273\u7EA2\u53D1\u7684\u77EE\u4EBA\uFF0C\u8FD9\u901A\u5E38\u88AB\u89C6\u4E3A\u62E5\u6709\u706B\u5143\u7D20\u4EB2\u548C\u529B\u7684\u8C61\u5F81\u3002\u4ED6\u4E0D\u4E60\u60EF\u7A7F\u6234\u6C89\u91CD\u7684\u94E0\u7532\uFF0C\u800C\u662F\u7A7F\u7740\u4E00\u4EF6\u7531\u5177\u6709\u9B54\u529B\u6297\u6027\u7684\u8D64\u7EA2\u4E1D\u7EF8\u7EC7\u6210\u7684\u534E\u4E3D\u6CD5\u888D\uFF0C\u8FD9\u4F7F\u4ED6\u5728\u6218\u573A\u4E0A\u5982\u540C\u7A7F\u68AD\u7684\u706B\u7130\u3002\u4ED6\u624B\u4E2D\u7684\u6218\u9524\u5E76\u975E\u7528\u4EE5\u6740\u654C\uFF0C\u800C\u662F\u4ED6\u65BD\u5C55\u7206\u88C2\u706B\u9B54\u6CD5\u7684\u5A92\u4ECB\u3002\u901A\u8FC7\u6218\u9524\uFF0C\u4ED6\u80FD\u5C06\u4F53\u5185\u72C2\u66B4\u7684\u706B\u7130\u9B54\u529B\u77AC\u95F4\u51DD\u805A\u5E76\u91CA\u653E\uFF0C\u5F62\u6210\u6BC1\u706D\u6027\u7684\u7206\u70B8\u3002\u4ED6\u7684\u6027\u683C\u6B63\u5982\u4ED6\u7684\u5934\u53D1\u548C\u9B54\u6CD5\uFF0C\u66B4\u8E81\u3001\u76F4\u63A5\u4E14\u5145\u6EE1\u4E86\u65E0\u53EF\u5339\u654C\u7684\u7834\u574F\u529B\u3002"
    heroSprite: {fileID: 21300000, guid: dd710d51cf613f14a94e657b78e45ec0, type: 3}
