  - heroId: 30
    heroName: "\u51E1\u6797"
    heroDescription: "\u51E1\u6797\u662F\u5C71\u5730\u5B66\u9662\u7684\u8D1F\u8D23\u4EBA\uFF0C\u957F\u671F\u7814\u7A76\u5965\u672F\u7406\u8BBA\u3001\u7A7A\u95F4\u8BB0\u5F55\u548C\u53E4\u4EE3\u6CD5\u672F\u8D44\u6599\u3002\u4ED6\u624B\u6301\u4E00\u67C4\u540D\u4E3A\u201C\u79D8\u5965\u201D\u7684\u6CD5\u6756\uFF0C\u9876\u7AEF\u9576\u5D4C\u7740\u4E00\u9897\u7EA2\u8272\u5B9D\u77F3\uFF0C\u6756\u8EAB\u5E26\u6709\u6728\u8D28\u7EB9\u7406\u548C\u7EC6\u5C0F\u7B26\u6587\u3002\u51E1\u6797\u6027\u683C\u6C89\u7A33\uFF0C\u8C08\u5410\u514B\u5236\uFF0C\u4E60\u60EF\u7528\u4E25\u8C28\u7684\u65B9\u6CD5\u6574\u7406\u590D\u6742\u95EE\u9898\u3002\u4ED6\u719F\u6089\u6CD5\u672F\u9635\u5217\u3001\u7B26\u6587\u7ED3\u6784\u548C\u7A7A\u95F4\u65B9\u4F4D\u7684\u8BB0\u5F55\u65B9\u5F0F\uFF0C\u4E5F\u5E38\u6307\u5BFC\u5E74\u8F7B\u5B66\u5458\u8FA8\u8BA4\u53E4\u4EE3\u6587\u732E\u4E2D\u7684\u56FE\u6848\u4E0E\u6807\u8BB0\u3002\u5BF9\u4ED6\u6765\u8BF4\uFF0C\u6CD5\u672F\u5E76\u4E0D\u662F\u70AB\u8000\u529B\u91CF\u7684\u624B\u6BB5\uFF0C\u800C\u662F\u4E00\u5957\u9700\u8981\u957F\u671F\u5B66\u4E60\u548C\u8C28\u614E\u4F7F\u7528\u7684\u77E5\u8BC6\u4F53\u7CFB\u3002"
