  - heroId: 29
    heroName: "\u6B27\u6797"
    heroDescription: "\u6B27\u6797\u662F\u5C71\u5730\u6BBF\u5802\u4E2D\u5E74\u957F\u7684\u5DE5\u5320\u4E0E\u7B26\u6587\u7814\u7A76\u8005\uFF0C\u7559\u7740\u94F6\u767D\u8272\u957F\u987B\uFF0C\u719F\u6089\u6BBF\u5802\u4E2D\u8BB8\u591A\u65E7\u8D44\u6599\u548C\u4F20\u7EDF\u5DE5\u827A\u3002\u5E74\u8F7B\u65F6\uFF0C\u4ED6\u5E38\u53C2\u4E0E\u5C71\u8DEF\u4FEE\u6574\u3001\u77FF\u77F3\u642C\u8FD0\u548C\u5DE5\u5177\u5236\u4F5C\u3002\u5E74\u7EAA\u6E10\u957F\u540E\uFF0C\u4ED6\u628A\u66F4\u591A\u7CBE\u529B\u653E\u5728\u53E4\u4EE3\u7B26\u6587\u3001\u5C71\u5730\u8BB0\u5F55\u548C\u65E7\u5F0F\u88C5\u5907\u7684\u6574\u7406\u4E0A\u3002\u6B27\u6797\u968F\u8EAB\u5E26\u7740\u4E00\u67C4\u53CC\u5203\u6218\u65A7\uFF0C\u65A7\u8EAB\u523B\u6709\u5BD2\u51B0\u7EB9\u6837\uFF0C\u65E2\u662F\u5DE5\u5177\uFF0C\u4E5F\u662F\u4ED6\u957F\u671F\u7814\u7A76\u7B26\u6587\u6280\u827A\u7684\u6210\u679C\u3002\u4ED6\u8BF4\u8BDD\u4E0D\u5FEB\uFF0C\u4F46\u5224\u65AD\u7A33\u59A5\uFF0C\u5E38\u80FD\u51ED\u501F\u591A\u5E74\u7ECF\u9A8C\u770B\u51FA\u5CA9\u5C42\u3001\u5929\u6C14\u548C\u9053\u8DEF\u53D8\u5316\u4E2D\u7684\u7EC6\u5FAE\u5DEE\u522B\u3002"
