  itemPrefabName: HeroBookItem
  heroDatas:
  - heroId: 1
    heroName: "\u4E9A\u745F"
    heroDescription: "\u4E9A\u745F\u51FA\u8EAB\u4E8E\u738B\u56FD\u9A91\u58EB\u961F\uFF0C\u81EA\u5E7C\u63A5\u53D7\u5251\u672F\u3001\u793C\u4EEA\u548C\u4E8B\u52A1\u5904\u7406\u8BAD\u7EC3\u3002\u4ED6\u7559\u7740\u8910\u8272\u77ED\u53D1\uFF0C\u76EE\u5149\u6C89\u7A33\uFF0C\u884C\u4E8B\u8BA4\u771F\u3002\u4E9A\u745F\u4F69\u6234\u5251\u4E0E\u76FE\uFF0C\u88C5\u5907\u9020\u578B\u7B80\u6D01\u5E84\u91CD\uFF0C\u662F\u4ED6\u957F\u671F\u8BAD\u7EC3\u548C\u5C65\u884C\u804C\u8D23\u7684\u8C61\u5F81\u3002\u5728\u738B\u56FD\u5404\u5730\u51FA\u73B0\u5F02\u5E38\u60C5\u51B5\u540E\uFF0C\u4E9A\u745F\u4E3B\u52A8\u53C2\u4E0E\u8C03\u67E5\u4E0E\u534F\u52A9\u5DE5\u4F5C\u3002\u4ED6\u64C5\u957F\u89C2\u5BDF\u73B0\u573A\u60C5\u51B5\uFF0C\u4E5F\u80FD\u5728\u961F\u4F0D\u9047\u5230\u56F0\u96BE\u65F6\u7A33\u5B9A\u5927\u5BB6\u7684\u60C5\u7EEA\u3002\u4F5C\u4E3A\u8F83\u65E9\u51FA\u73B0\u7684\u52C7\u8005\u4E4B\u4E00\uFF0C\u4E9A\u745F\u4EE3\u8868\u7740\u8D23\u4EFB\u3001\u5B88\u62A4\u4E0E\u79E9\u5E8F\u3002"
    heroSprite: {fileID: 21300000, guid: 462050d1afdbd72448df26a675ae0117, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a566b9dafc4a3af40b5991e8617d9d29, type: 3}
