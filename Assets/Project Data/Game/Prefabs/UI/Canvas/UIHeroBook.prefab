  - heroId: 2
    heroName: "\u5170\u65AF\u6D1B\u7279"
    heroDescription: "\u5170\u65AF\u6D1B\u7279\u662F\u738B\u56FD\u5B88\u536B\u961F\u4E2D\u8F83\u4E3A\u5E74\u8F7B\u7684\u5251\u672F\u597D\u624B\u3002\u4ED6\u8EAB\u7A7F\u7EBF\u6761\u7B80\u6D01\u7684\u767D\u91D1\u94E0\u7532\uFF0C\u624B\u6301\u4E00\u67C4\u4FEE\u957F\u7684\u957F\u5251\uFF0C\u884C\u52A8\u8FC5\u6377\uFF0C\u53CD\u5E94\u654F\u9510\u3002\u5170\u65AF\u6D1B\u7279\u6027\u683C\u8BA4\u771F\uFF0C\u5BF9\u81EA\u8EAB\u8981\u6C42\u8F83\u9AD8\uFF0C\u5728\u65E5\u5E38\u8BAD\u7EC3\u548C\u5DE1\u67E5\u4E2D\u59CB\u7EC8\u4FDD\u6301\u4E13\u6CE8\u3002\u4ED6\u719F\u6089\u57CE\u9547\u9053\u8DEF\u548C\u5B88\u536B\u961F\u7684\u884C\u52A8\u65B9\u5F0F\uFF0C\u80FD\u591F\u4ECE\u7EC6\u8282\u4E2D\u5224\u65AD\u4E8B\u4EF6\u7684\u8D70\u5411\uFF0C\u4E5F\u56E0\u6B64\u9010\u6E10\u88AB\u4EBA\u4EEC\u89C6\u4E3A\u65B0\u4E00\u4EE3\u52C7\u8005\u4E4B\u4E00\u3002"
