    heroDescription: "\u4E3D\u5948\u7279\u662F\u738B\u56FD\u6CD5\u672F\u7814\u7A76\u4F1A\u4E2D\u7684\u5E74\u8F7B\u6210\u5458\uFF0C\u64C5\u957F\u6574\u7406\u661F\u8C61\u8BB0\u5F55\u548C\u53E4\u4EE3\u5377\u8F74\u3002\u5979\u6709\u4E00\u5934\u84DD\u8272\u957F\u53D1\uFF0C\u8EAB\u7A7F\u767D\u8272\u4E0E\u84DD\u8272\u76F8\u95F4\u7684\u6CD5\u888D\uFF0C\u8863\u9970\u4E0A\u70B9\u7F00\u7740\u661F\u8FB0\u7EB9\u6837\uFF0C\u6574\u4F53\u9020\u578B\u660E\u4EAE\u800C\u8F7B\u76C8\u3002\u4E3D\u5948\u7279\u5E38\u968F\u8EAB\u643A\u5E26\u4E00\u672C\u6CD5\u672F\u4E66\uFF0C\u7528\u6765\u8BB0\u5F55\u5404\u5730\u51FA\u73B0\u7684\u7279\u6B8A\u73B0\u8C61\u3002\u5979\u6027\u683C\u5B89\u9759\uFF0C\u505A\u4E8B\u7EC6\u81F4\uFF0C\u5584\u4E8E\u4ECE\u6587\u5B57\u3001\u56FE\u6848\u548C\u6CD5\u9635\u75D5\u8FF9\u4E2D\u53D1\u73B0\u89C4\u5F8B\u3002\u8BB8\u591A\u770B\u4F3C\u96F6\u6563\u7684\u7EBF\u7D22\uFF0C\u7ECF\u5979\u6574\u7406\u540E\u90FD\u4F1A\u53D8\u5F97\u6E05\u695A\u8D77\u6765\u3002"
    heroSprite: {fileID: 21300000, guid: d80261d39b3dad9408b94c1cdf670eec, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a9302cc202dfa4e45afe3600dc2877da, type: 3}
    defaultUnlocked: 0
  - heroId: 6
    heroName: "\u585E\u62C9\u83F2\u5A1C"
    heroDescription: "\u585E\u62C9\u83F2\u5A1C\u662F\u738B\u56FD\u836F\u5242\u7814\u7A76\u6240\u7684\u6210\u5458\uFF0C\u64C5\u957F\u8C03\u914D\u8349\u836F\u836F\u5242\uFF0C\u4E5F\u719F\u6089\u57FA\u7840\u7684\u6062\u590D\u6CD5\u672F\u3002\u5979\u8EAB\u7A7F\u5E26\u6709\u91D1\u8272\u7EB9\u6837\u7684\u767D\u8272\u957F\u888D\uFF0C\u624B\u6301\u4E00\u67C4\u9576\u5D4C\u5B9D\u77F3\u7684\u6CD5\u6756\uFF0C\u6574\u4F53\u6C14\u8D28\u6E29\u548C\u5B89\u9759\u3002\u585E\u62C9\u83F2\u5A1C\u5E38\u5E74\u6574\u7406\u5404\u5730\u8349\u836F\u8D44\u6599\uFF0C\u5E76\u6839\u636E\u4E0D\u540C\u5730\u533A\u7684\u73AF\u5883\u5236\u4F5C\u968F\u8EAB\u836F\u5242\u3002\u5979\u4E0D\u64C5\u957F\u6B63\u9762\u51B2\u7A81\uFF0C\u66F4\u4E60\u60EF\u5728\u961F\u4F0D\u4F11\u6574\u65F6\u7167\u770B\u540C\u4F34\u3001\u8BB0\u5F55\u4F24\u60C5\u548C\u51C6\u5907\u8865\u7ED9\u3002\u8BB8\u591A\u4EBA\u8BB0\u5F97\u5979\uFF0C\u662F\u56E0\u4E3A\u5979\u603B\u80FD\u5728\u6700\u9700\u8981\u7684\u65F6\u5019\u62FF\u51FA\u5408\u9002\u7684\u836F\u5242\u3002"
    heroSprite: {fileID: 21300000, guid: ebf08b6401d2c29409584ec3d871027f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1defb35aad4e48245abf602bfede213c, type: 3}
    defaultUnlocked: 0
  - heroId: 7
    heroName: "\u6258\u6797"
    heroDescription: "\u6258\u6797\u7ECF\u8425\u7740\u65E7\u4E66\u8857\u4E0A\u4E00\u5BB6\u5C0F\u4E66\u5E97\uFF0C\u5E73\u65F6\u5E38\u6234\u5706\u6846\u773C\u955C\uFF0C\u559C\u6B22\u62B1\u7740\u539A\u91CD\u7684\u53E4\u7C4D\u7814\u7A76\u7B14\u8BB0\u3002\u4ED6\u719F\u6089\u53E4\u4EE3\u9057\u8FF9\u3001\u65E7\u5730\u56FE\u548C\u5404\u7C7B\u6C11\u95F4\u4F20\u8BF4\uFF0C\u4E5F\u7ECF\u5E38\u72EC\u81EA\u524D\u5F80\u504F\u8FDC\u5730\u533A\u6574\u7406\u9057\u8FF9\u8D44\u6599\u3002\u6258\u6797\u8EAB\u7A7F\u4FBF\u4E8E\u65C5\u884C\u7684\u8863\u670D\uFF0C\u968F\u8EAB\u643A\u5E26\u5DE5\u5177\u5305\u3001\u8BB0\u5F55\u518C\u3002\u4ED6\u624B\u4E2D\u7684\u300A\u53E4\u8FF9\u5BC6\u5377\u300B\u8BB0\u5F55\u7740\u8BB8\u591A\u5DF2\u7ECF\u5C11\u6709\u4EBA\u77E5\u7684\u7B26\u6587\u77E5\u8BC6\u3002\u5BF9\u6258\u6797\u6765\u8BF4\uFF0C\u6BCF\u4E00\u5757\u6B8B\u7F3A\u77F3\u7891\u3001\u6BCF\u4E00\u6BB5\u6A21\u7CCA\u6587\u5B57\uFF0C\u90FD\u53EF\u80FD\u85CF\u7740\u901A\u5F80\u65E7\u65F6\u4EE3\u7684\u7EBF\u7D22\u3002"
    heroSprite: {fileID: 21300000, guid: 3047b6a19e7618746af2c148ebfedb3f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 8917838ee30c134408dd00c82cd70f88, type: 3}
    defaultUnlocked: 0
  - heroId: 8
    heroName: "\u7F57\u4F0A"
    heroDescription: "\u7F57\u4F0A\u662F\u4E00\u540D\u56DB\u5904\u65C5\u884C\u7684\u5251\u5BA2\uFF0C\u5E73\u65F6\u5E38\u5728\u4E0D\u540C\u57CE\u9547\u4E4B\u95F4\u5F80\u6765\uFF0C\u9760\u63A5\u53D7\u62A4\u9001\u3001\u5BFB\u7269\u548C\u8DEF\u7EBF\u63A2\u67E5\u7B49\u59D4\u6258\u7EF4\u6301\u751F\u6D3B\u3002\u4ED6\u8EAB\u7A7F\u4E00\u5957\u5DF2\u7ECF\u892A\u8272\u7684\u76AE\u7532\uFF0C\u5934\u53D1\u77ED\u800C\u8302\u5BC6\uFF0C\u968F\u8EAB\u643A\u5E26\u4E00\u67C4\u4FDD\u517B\u826F\u597D\u7684\u77ED\u5251\u3002\u7F57\u4F0A\u8BDD\u4E0D\u591A\uFF0C\u6027\u683C\u8C28\u614E\uFF0C\u5BF9\u5404\u5730\u9053\u8DEF\u3001\u96C6\u5E02\u548C\u65C5\u5E97\u4F20\u95FB\u90FD\u5F88\u719F\u6089\u3002\u4ED6\u4E0D\u592A\u4E60\u60EF\u542C\u4ECE\u7A7A\u6CDB\u7684\u8BF4\u6CD5\uFF0C\u66F4\u76F8\u4FE1\u4EB2\u773C\u770B\u5230\u7684\u7EBF\u7D22\u548C\u81EA\u5DF1\u4E00\u8DEF\u79EF\u7D2F\u7684\u7ECF\u9A8C\u3002\u8BB8\u591A\u522B\u4EBA\u5FFD\u7565\u7684\u5C0F\u6D88\u606F\uFF0C\u5230\u4E86\u4ED6\u8FD9\u91CC\u5F80\u5F80\u80FD\u62FC\u51FA\u5B8C\u6574\u7684\u65B9\u5411\u3002"
    heroSprite: {fileID: 21300000, guid: 6380f5f94ca703a448fbab1c5cc68d61, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1197a2d2c7e59924795fcaabce05c278, type: 3}
    defaultUnlocked: 0
  - heroId: 9
    heroName: "\u6C49\u65AF"
    heroDescription: "\u6C49\u65AF\u539F\u672C\u662F\u7ECF\u5E38\u5728\u5E02\u9547\u4E4B\u95F4\u8BA8\u751F\u6D3B\u7684\u666E\u901A\u4EBA\uFF0C\u505A\u8FC7\u642C\u8FD0\u3001\u4FEE\u8865\u548C\u4E34\u65F6\u62A4\u9001\u7B49\u5DE5\u4F5C\u3002\u4ED6\u8EAB\u4E0A\u7684\u62AB\u98CE\u5DF2\u7ECF\u6709\u4E9B\u78E8\u65E7\uFF0C\u94E0\u7532\u4E5F\u5E26\u7740\u591A\u5904\u4FEE\u8865\u75D5\u8FF9\uFF0C\u770B\u4E0A\u53BB\u5E76\u4E0D\u663E\u773C\u3002\u6C49\u65AF\u6027\u683C\u968F\u548C\uFF0C\u8BF4\u8BDD\u5E26\u7740\u5E02\u4E95\u91CC\u7684\u5E7D\u9ED8\u611F\uFF0C\u4E5F\u5F88\u4E86\u89E3\u666E\u901A\u4EBA\u7684\u65E5\u5E38\u56F0\u96BE\u3002\u4ED6\u4E0D\u8FFD\u6C42\u534E\u4E3D\u7684\u540D\u58F0\uFF0C\u66F4\u4E60\u60EF\u7528\u7B80\u5355\u5B9E\u7528\u7684\u65B9\u6CD5\u5904\u7406\u95EE\u9898\u3002\u5728\u8BB8\u591A\u7D27\u5F20\u7684\u573A\u5408\u91CC\uFF0C\u4ED6\u53CD\u800C\u80FD\u7528\u51E0\u53E5\u73A9\u7B11\u7F13\u548C\u6C14\u6C1B\uFF0C\u8BA9\u8EAB\u8FB9\u7684\u4EBA\u91CD\u65B0\u7A33\u4F4F\u5FC3\u795E\u3002"
    heroSprite: {fileID: 21300000, guid: 407a578498353804e93ed1273305c3dd, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: ad54aa6591811174b88bbece43ee53a9, type: 3}
    defaultUnlocked: 0
  - heroId: 10
    heroName: "\u83B1\u7EB3"
    heroDescription: "\u83B1\u7EB3\u66FE\u5728\u57CE\u9632\u961F\u4E2D\u8D1F\u8D23\u7CAE\u4ED3\u5DE1\u67E5\uFF0C\u5E73\u65F6\u505A\u4E8B\u7EC6\u81F4\uFF0C\u4E5F\u5F88\u64C5\u957F\u8BA1\u7B97\u7269\u8D44\u548C\u8DEF\u7A0B\u3002\u4ED6\u9876\u7740\u4E00\u5934\u7565\u663E\u6742\u4E71\u7684\u77ED\u53D1\uFF0C\u8EAB\u7A7F\u6734\u7D20\u7684\u68C9\u7532\uFF0C\u624B\u4E2D\u5E38\u5E26\u7740\u4E00\u628A\u65E7\u94C1\u5F13\u3002\u867D\u7136\u88C5\u5907\u5E76\u4E0D\u663E\u773C\uFF0C\u4F46\u83B1\u7EB3\u5BF9\u8DDD\u79BB\u3001\u98CE\u5411\u548C\u5730\u5F62\u6709\u7740\u5F88\u5F3A\u7684\u5224\u65AD\u529B\u3002\u4ED6\u6027\u683C\u5B9E\u9645\uFF0C\u4E0D\u559C\u6B22\u5192\u8FDB\uFF0C\u9047\u5230\u95EE\u9898\u65F6\u603B\u4F1A\u5148\u89C2\u5BDF\u5468\u56F4\u73AF\u5883\uFF0C\u518D\u9009\u62E9\u5408\u9002\u7684\u4F4D\u7F6E\u884C\u52A8\u3002\u957F\u671F\u7BA1\u7406\u7CAE\u4ED3\u7684\u7ECF\u5386\uFF0C\u8BA9\u4ED6\u517B\u6210\u4E86\u8C28\u614E\u548C\u7CBE\u6253\u7EC6\u7B97\u7684\u4E60\u60EF\u3002"
    heroSprite: {fileID: 21300000, guid: c04e2be7f337b45448847b79cc9f9984, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 8cf7a8086b7835449ae583206e7b60ac, type: 3}
    defaultUnlocked: 0
  - heroId: 11
    heroName: "\u94C1\u725B"
    heroDescription: "\u94C1\u725B\u66FE\u5728\u91C7\u77F3\u573A\u5DE5\u4F5C\uFF0C\u957F\u671F\u8D1F\u8D23\u642C\u8FD0\u77F3\u6599\u548C\u4FEE\u6574\u5C71\u8DEF\u3002\u4ED6\u8EAB\u6750\u7ED3\u5B9E\uFF0C\u5934\u53D1\u5448\u84DD\u8272\uFF0C\u8EAB\u7A7F\u539A\u5B9E\u7684\u76AE\u7532\uFF0C\u624B\u4E2D\u5E38\u5E26\u7740\u4E00\u67C4\u7528\u4E8E\u5F00\u77F3\u548C\u6E05\u8DEF\u7684\u6D41\u661F\u9524\u3002\u94C1\u725B\u5E73\u65F6\u8BDD\u4E0D\u591A\uFF0C\u6027\u683C\u76F4\u723D\uFF0C\u505A\u4E8B\u8BA4\u51C6\u4E86\u5C31\u4F1A\u575A\u6301\u5230\u5E95\u3002\u4ED6\u4E0D\u592A\u64C5\u957F\u590D\u6742\u7684\u8A00\u8F9E\uFF0C\u5374\u5F88\u4E86\u89E3\u5C71\u77F3\u3001\u9053\u8DEF\u548C\u4F53\u529B\u6D3B\u7684\u95E8\u9053\u3002\u9047\u5230\u5835\u585E\u7684\u5C71\u8DEF\u6216\u5012\u843D\u7684\u77F3\u5757\u65F6\uFF0C\u4ED6\u603B\u80FD\u7528\u6700\u76F4\u63A5\u7684\u65B9\u6CD5\u628A\u9053\u8DEF\u91CD\u65B0\u6E05\u7406\u51FA\u6765\u3002"
    heroSprite: {fileID: 21300000, guid: 733da8621d19939429a2fa92b3b5f592, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 679fc04e8569a2841809f3eb6d197331, type: 3}
    defaultUnlocked: 0
  - heroId: 12
    heroName: "\u8FEA\u514B"
    heroDescription: "\u8FEA\u514B\u539F\u672C\u662F\u7ECF\u5E38\u51FA\u5165\u77FF\u533A\u7684\u63A2\u8DEF\u4EBA\uFF0C\u719F\u6089\u5730\u4E0B\u901A\u9053\u3001\u5CA9\u5C42\u8D70\u5411\u548C\u77FF\u77F3\u5206\u5E03\u3002\u4ED6\u6709\u4E00\u9897\u9192\u76EE\u7684\u5149\u5934\uFF0C\u8EAB\u4E0A\u6302\u7740\u8BB8\u591A\u81EA\u5DF1\u6536\u96C6\u7684\u5C0F\u5DE5\u5177\u548C\u62A4\u8EAB\u6302\u9970\uFF0C\u770B\u8D77\u6765\u673A\u7075\u53C8\u5FD9\u788C\u3002\u8FEA\u514B\u5E38\u7528\u4E00\u5BF9\u77ED\u67C4\u9524\u5904\u7406\u77FF\u77F3\u548C\u4FEE\u6574\u901A\u9053\uFF0C\u867D\u7136\u8EAB\u6750\u4E0D\u9AD8\uFF0C\u4F46\u884C\u52A8\u7075\u6D3B\uFF0C\u5BF9\u72ED\u7A84\u5730\u5F62\u5F88\u6709\u7ECF\u9A8C\u3002\u4ED6\u6027\u683C\u76F4\u7387\uFF0C\u559C\u6B22\u8BA1\u7B97\u6536\u83B7\uFF0C\u4E5F\u61C2\u5F97\u5728\u590D\u6742\u73AF\u5883\u4E2D\u5BFB\u627E\u5B89\u5168\u8DEF\u5F84\u3002\u53EA\u8981\u8FDB\u5165\u77FF\u9053\uFF0C\u4ED6\u603B\u80FD\u5F88\u5FEB\u5224\u65AD\u54EA\u91CC\u9002\u5408\u901A\u884C\uFF0C\u54EA\u91CC\u9700\u8981\u7ED5\u5F00\u3002"
    heroSprite: {fileID: 21300000, guid: e3a73cb9d0322b34e8da22de1f222feb, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: d08e4a0020353fd44a3076bdaed6a227, type: 3}
